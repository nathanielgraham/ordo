# Git / editor
.git
.gitignore
.howto.swp
*.swp
*~

# Secrets — never bake into the image
.env
.env.*
ordo-license-private.pem
ordo-license-public.pem

# Runtime data (use volumes instead)
db/*
data/*
config/*
!db/.gitkeep
!data/.gitkeep
!config/.gitkeep

# Release artifacts
*.tar.gz
*.tar.gz.sha256
ordo-selfhosted-*/

# Host-only helpers (not required at runtime in the container)
tools/
share.sh
howto
README.md

# Logs / junk
**/*.log
*.pem


