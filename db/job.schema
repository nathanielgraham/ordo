PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS job;
CREATE TABLE job (
        id INTEGER PRIMARY KEY NOT NULL,
	mode INTEGER NOT NULL DEFAULT 770,
        cluster_id INTEGER,
        server_id INTEGER,
        shell_command varchar,
        state_id INTEGER NOT NULL DEFAULT 2,
        name varchar,
        description varchar,
        started INTEGER,
        ended INTEGER,
        pctcpu real,
        pid integer,
        time integer,
        start integer,
        size integer,
        priority integer,
        rss integer,
        pctmem real,
        ppid integer,
        cmndline varchar,
        fname varchar,
        state varchar,
	exit_code integer,
	signal integer,
	watcher integer not null default 0,
	last_update integer,
        restart_max INTEGER NOT NULL DEFAULT 0,
        restart_delay INTEGER NOT NULL DEFAULT 0,
        creation_time integer DEFAULT (strftime('%s', 'now')),
        FOREIGN KEY(server_id) REFERENCES server(id) ON DELETE CASCADE,
        FOREIGN KEY(cluster_id) REFERENCES cluster(id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX job_idx1 ON job (cluster_id, name);

COMMIT;
