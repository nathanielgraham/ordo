PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS job;
CREATE TABLE job (
        id INTEGER PRIMARY KEY NOT NULL,
	mode INTEGER NOT NULL DEFAULT 770,
        cluster_id INTEGER,
        server_id INTEGER,
        shell_command varchar,
        state_id INTEGER NOT NULL DEFAULT 1,
        name varchar,
        description varchar,
        started INTEGER,
        ended INTEGER,
        pctcpu real,
        pid integer,
        time integer,
        start integer,
        size integer,
        priority integer,
        rss integer,
        pctmem real,
        ppid integer,
        state varchar,
	exit_code integer,
	last_update integer,
        out_log_path varchar,
        err_log_path varchar,
        restart_max INTEGER NOT NULL DEFAULT 0,
        restart_delay INTEGER NOT NULL DEFAULT 0,
        creation_time DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(server_id) REFERENCES server(id),
        FOREIGN KEY(cluster_id) REFERENCES cluster(id)
);

CREATE UNIQUE INDEX job_idx1 ON job (cluster_id, name);

COMMIT;
