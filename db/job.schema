PRAGMA foreign_keys=on;
BEGIN TRANSACTION;

DROP TABLE IF EXISTS job;

CREATE TABLE job (
    id                     INTEGER PRIMARY KEY NOT NULL,
    cluster_id             INTEGER REFERENCES cluster(id) ON DELETE CASCADE,
    server_id              INTEGER REFERENCES server(id) ON DELETE SET NULL,
    state_id               INTEGER NOT NULL DEFAULT 2,
    name                   VARCHAR,
    script                 TEXT,
    description            VARCHAR,
    delay                  INTEGER NOT NULL DEFAULT 0,
    retrys                 INTEGER NOT NULL DEFAULT 0,
    retry_count            INTEGER NOT NULL DEFAULT 0,
    loops                  INTEGER NOT NULL DEFAULT 0,
    loop_count             INTEGER NOT NULL DEFAULT 0,
    max_runtime_seconds    INTEGER DEFAULT NULL,
    max_runtime_cluster_id INTEGER REFERENCES cluster(id) ON DELETE SET NULL,
    clone_job_id           INTEGER REFERENCES job(id) ON DELETE SET NULL,
    started                INTEGER,
    ended                  INTEGER,
    last_update            INTEGER,
    pid                    INTEGER,
    ppid                   INTEGER,
    exit_code              INTEGER,
    signal                 INTEGER,
    pctcpu                 REAL,
    pctmem                 REAL,
    rss                    INTEGER,
    priority               INTEGER,
    fname                  VARCHAR,
    json                   TEXT,
    creation_time          INTEGER DEFAULT (strftime('%s', 'now'))
);

-- Indexes
CREATE UNIQUE INDEX job_idx1             ON job (cluster_id, name);
CREATE INDEX idx_job_cluster_state       ON job (cluster_id, state_id);
CREATE INDEX idx_job_server              ON job (server_id);
CREATE INDEX idx_job_max_runtime         ON job (max_runtime_cluster_id) WHERE max_runtime_cluster_id IS NOT NULL;
CREATE INDEX idx_job_clone               ON job (clone_job_id);

COMMIT;
