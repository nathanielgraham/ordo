PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS job;
CREATE TABLE job (
        id INTEGER PRIMARY KEY NOT NULL,
	mode INTEGER NOT NULL DEFAULT 770,
        cluster_id INTEGER REFERENCES cluster(id) ON DELETE CASCADE,
        server_id INTEGER REFERENCES server(id) ON DELETE CASCADE,
        shell_command varchar,
        state_id INTEGER NOT NULL DEFAULT 2,
        name varchar,
        description varchar,
        started INTEGER,
        ended INTEGER,
        pctcpu real,
        pid integer,
        time integer,
        start integer,
        size integer,
        priority integer,
        rss integer,
        pctmem real,
        ppid integer,
        cmndline varchar,
        fname varchar,
        state varchar,
	exit_code integer,
	signal integer,
	watcher integer,
	clone_job_id integer,
        fail_alarm integer, 
        max_pctcpu real,
        max_pctcpu_alarm integer,
        max_pctmem real,
        max_pctmem_alarm integer,
        max_duration integer,
        max_duration_alarm integer,
        retrys integer,
        retry_count integer not null default 0,
	last_update integer,
        creation_time integer DEFAULT (strftime('%s', 'now'))
);

CREATE UNIQUE INDEX job_idx1 ON job (cluster_id, name);

COMMIT;
