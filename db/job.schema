PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS job;
CREATE TABLE job (
        id INTEGER PRIMARY KEY NOT NULL,
	mode INTEGER NOT NULL DEFAULT 770,
        cluster_id INTEGER REFERENCES cluster(id) ON DELETE CASCADE,
        server_id INTEGER REFERENCES server(id) ON DELETE SET NULL ON UPDATE CASCADE,
        script varchar,
        state_id INTEGER NOT NULL DEFAULT 2,
        name varchar,
        description varchar,
        started INTEGER,
        ended INTEGER,
        pctcpu real,
        pid integer,
        time integer,
        start integer,
        size integer,
        priority integer,
        rss integer,
        pctmem real,
        ppid integer,
        fname varchar,
        state varchar,
	exit_code integer,
	signal integer,
	watcher integer,
	json text,
        fail_hook INTEGER REFERENCES cluster(id) ON DELETE SET NULL ON UPDATE CASCADE, 
        max_cpu real,
        max_cpu_hook INTEGER REFERENCES cluster(id) ON DELETE SET NULL ON UPDATE CASCADE,
        max_mem real,
        max_mem_hook INTEGER REFERENCES cluster(id) ON DELETE SET NULL ON UPDATE CASCADE,
        max_duration integer,
        max_duration_hook INTEGER REFERENCES cluster(id) ON DELETE SET NULL ON UPDATE CASCADE,
        retrys integer integer not null default 0,
        retry_count integer not null default 0,
        retry_delay integer not null default 0,
        loops integer integer not null default 0,
        loop_count integer not null default 0,
        loop_delay integer not null default 0,
	last_update integer,
        creation_time integer DEFAULT (strftime('%s', 'now'))
);

CREATE UNIQUE INDEX job_idx1 ON job (cluster_id, name);

COMMIT;
