PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS job;
CREATE TABLE job (
        id INTEGER PRIMARY KEY NOT NULL,
        job_definition_id INTEGER,
        cluster_id INTEGER,
        server_id INTEGER,
        state_id INTEGER NOT NULL DEFAULT 1,
        pid INTEGER,
        name varchar,
        description varchar,
        creation_time DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(job_definition_id) REFERENCES job_definition(id),
        FOREIGN KEY(cluster_id) REFERENCES cluster(id)
);

CREATE UNIQUE INDEX job_idx1 ON job (job_definition_id, cluster_id);

COMMIT;
