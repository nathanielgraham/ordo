PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS org;
CREATE TABLE org (
        id INTEGER PRIMARY KEY NOT NULL,
        root_cluster_id integer,
        name varchar,
        description varchar,
        update_time integer,
        tier text DEFAULT 'free',
        execution_token varchar,
        execution_token_created_at integer DEFAULT (strftime('%s', 'now')),
        rate_limit_user_per_minute INTEGER DEFAULT 100,
        rate_limit_org_per_minute INTEGER DEFAULT 500,
        creation_time integer DEFAULT (strftime('%s', 'now'))
);
COMMIT;
