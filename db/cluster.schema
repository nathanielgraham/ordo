PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS cluster;
CREATE TABLE cluster (
        id INTEGER PRIMARY KEY NOT NULL,
  	org_id INTEGER,
  	parent_id INTEGER,
	state_id INTEGER,
	server_id INTEGER,
	name varchar,
	description varchar,
        creation_time DEFAULT CURRENT_TIMESTAMP,
  	FOREIGN KEY(org_id) REFERENCES org(id) ON UPDATE CASCADE ON DELETE SET NULL,
  	FOREIGN KEY(server_id) REFERENCES server(id) ON UPDATE CASCADE ON DELETE SET NULL,
  	FOREIGN KEY(parent_id) REFERENCES cluster(id) ON UPDATE CASCADE ON DELETE SET NULL
);

CREATE UNIQUE INDEX cluster_idx1 ON cluster (org_id, name, parent_id);

COMMIT;
