PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS cluster;
CREATE TABLE cluster (
        id INTEGER PRIMARY KEY NOT NULL,
  	mode varchar NOT NULL DEFAULT '770',
  	org_id INTEGER REFERENCES org(id) ON DELETE CASCADE,
  	user_id INTEGER REFERENCES user(id) REFERENCES user(id) ON DELETE CASCADE,
  	parent_id INTEGER REFERENCES cluster(id) ON DELETE CASCADE,
        state_id INTEGER NOT NULL DEFAULT 2,
	server_id INTEGER REFERENCES server(id) ON DELETE SET NULL,
	cal_id INTEGER REFERENCES cal(id) ON DELETE SET NULL,
	name varchar,
	description varchar,
	next_start INTEGER,
	started INTEGER,
	ended INTEGER,
	json text,
        fail_alarm integer REFERENCES cluster(id) ON DELETE SET NULL, 
        clonable integer, 
        clone_cluster_id integer REFERENCES cluster(id) ON DELETE CASCADE,
        loops integer integer not null default 0,
        loop_count integer not null default 0,
        creation_time integer DEFAULT (strftime('%s', 'now'))
);

CREATE UNIQUE INDEX cluster_idx1 ON cluster (org_id, name, parent_id);

COMMIT;
