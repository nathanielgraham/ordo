PRAGMA foreign_keys=on;
BEGIN TRANSACTION;

DROP TABLE IF EXISTS cluster;

CREATE TABLE cluster (
    id                 INTEGER PRIMARY KEY NOT NULL,
    org_id             INTEGER REFERENCES org(id) ON DELETE CASCADE,
    user_id            INTEGER REFERENCES user(id) ON DELETE SET NULL,
    parent_id          INTEGER REFERENCES cluster(id) ON DELETE CASCADE,
    state_id           INTEGER NOT NULL DEFAULT 2,
    server_id          INTEGER REFERENCES server(id) ON DELETE SET NULL,
    cal_id             INTEGER REFERENCES cal(id) ON DELETE SET NULL,
    name               VARCHAR,
    description        VARCHAR,
    next_start         INTEGER,
    started            INTEGER,
    ended              INTEGER,
    json               TEXT,
    handler_context    TEXT,
    on_fail_id         INTEGER REFERENCES cluster(id) ON DELETE SET NULL,
    on_overdue_id      INTEGER REFERENCES cluster(id) ON DELETE SET NULL,
    auto_start         INTEGER NOT NULL DEFAULT 1,
    clone_cluster_id   INTEGER REFERENCES cluster(id) ON DELETE CASCADE,
    loops              INTEGER NOT NULL DEFAULT 0,
    loop_count         INTEGER NOT NULL DEFAULT 0,
    overdue_since      INTEGER,
    creation_time      INTEGER DEFAULT (strftime('%s', 'now'))
);

-- Indexes
CREATE UNIQUE INDEX cluster_idx1        ON cluster (org_id, name, parent_id);
CREATE INDEX idx_cluster_parent         ON cluster (parent_id);
CREATE INDEX idx_cluster_on_fail        ON cluster (on_fail_id);
CREATE INDEX idx_cluster_on_overdue     ON cluster (on_overdue_id);

COMMIT;
