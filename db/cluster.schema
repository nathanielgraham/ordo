PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS cluster;
CREATE TABLE cluster (
        id INTEGER PRIMARY KEY NOT NULL,
  	mode varchar NOT NULL DEFAULT 770,
  	org_id INTEGER,
  	user_id INTEGER,
  	parent_id INTEGER,
        state_id INTEGER NOT NULL DEFAULT 2,
	server_id INTEGER,
	name varchar,
	command varchar,
	description varchar,
	next_start INTEGER,
	started INTEGER,
	ended INTEGER,
        creation_time integer DEFAULT (strftime('%s', 'now')),
  	FOREIGN KEY(org_id) REFERENCES org(id),
  	FOREIGN KEY(user_id) REFERENCES user(id),
  	FOREIGN KEY(server_id) REFERENCES server(id),
  	FOREIGN KEY(parent_id) REFERENCES cluster(id)
);

CREATE UNIQUE INDEX cluster_idx1 ON cluster (org_id, name, parent_id);

COMMIT;
