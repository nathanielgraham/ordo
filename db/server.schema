PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS server;
CREATE TABLE server (
        id INTEGER PRIMARY KEY NOT NULL,
        org_id INTEGER,
        name varchar,
        username varchar,
        password varchar,
        hostname varchar,
        os varchar,
	cwd varchar,
	home varchar,
	cores integer,
        port integer not null default 22,
        total_memory integer,
        used_memory integer,
        total_disk integer,
        used_disk integer,
        uptime integer,
        cpu real,
        ping real,
	update_time integer,
        creation_time DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX server_idx1 ON server (org_id, hostname);

COMMIT;
