PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS server;
CREATE TABLE server (
        id INTEGER PRIMARY KEY NOT NULL,
        org_id INTEGER,
        name varchar,
        username varchar,
        password varchar,
        hostname varchar,
        port integer,
        creation_time DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX server_idx1 ON server (org_id, name);

COMMIT;
