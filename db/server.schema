PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS server;
CREATE TABLE server (
        id INTEGER PRIMARY KEY NOT NULL,
        org_id INTEGER,
        name varchar,
        username varchar,
        password varchar,
        hostname varchar,
        os varchar,
	cwd varchar,
	home varchar,
	cores integer,
        port integer not null default 22,
        total_memory integer,
        used_memory integer,
        total_disk integer,
        used_disk integer,
        uptime integer,
        cpu real,
        ping real,
        max_pctcpu real,
        max_pctcpu_cluster_id integer,
        max_pctmem real,
        max_pctmem_cluster_id integer,
        max_pctdisk real,
        max_pctdisk_cluster_id integer,
        max_loadavg real,
        max_loadavg_cluster_id integer,
        max_uptime real,
        max_uptime_cluster_id integer,
        max_ping real,
        max_ping_cluster_id integer,
        max_updated integer,
        max_updated_cluster_id integer,
	update_time integer,
        creation_time DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX server_idx1 ON server (org_id, hostname);

COMMIT;
