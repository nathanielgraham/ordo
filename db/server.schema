PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS server;
CREATE TABLE server (
        id INTEGER PRIMARY KEY NOT NULL,
        org_id INTEGER REFERENCES org(id) ON DELETE CASCADE,
        name varchar,
        user varchar,
        host varchar,
        ip_address varchar,
        password varchar,
        os varchar,
	cwd varchar,
	home varchar,
	cores integer,
        port integer not null default 22,
        total_memory integer,
        used_memory integer,
        total_disk integer,
        used_disk integer,
        uptime integer,
        cpu real,
        ping real,
        max_cpu real,
        max_cpu_hook integer REFERENCES cluster(id) ON DELETE SET NULL,
        max_mem real,
        max_mem_hook integer REFERENCES cluster(id) ON DELETE SET NULL,
        max_disk real,
        max_disk_hook integer REFERENCES cluster(id) ON DELETE SET NULL,
        max_loadavg real,
        max_loadavg_hook integer REFERENCES cluster(id) ON DELETE SET NULL,
        max_uptime real,
        max_uptime_hook integer REFERENCES cluster(id) ON DELETE SET NULL,
        max_ping real,
        max_ping_hook integer REFERENCES cluster(id) ON DELETE SET NULL,
        max_updated integer,
        max_updated_hook integer REFERENCES cluster(id) ON DELETE SET NULL,
	update_time integer,
        creation_time integer DEFAULT (strftime('%s', 'now'))
);

CREATE UNIQUE INDEX server_idx1 ON server (org_id, host);

COMMIT;
