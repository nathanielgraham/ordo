PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS cluster_need;
CREATE TABLE cluster_need (
        id INTEGER PRIMARY KEY NOT NULL,
        cluster_id INTEGER,
        need_cluster_id INTEGER,
        FOREIGN KEY(cluster_id) REFERENCES cluster(id),
        FOREIGN KEY(need_cluster_id) REFERENCES cluster(id)
);

CREATE UNIQUE INDEX cluster_need_idx1 ON cluster_need (cluster_id, need_cluster_id);

COMMIT;
