PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS job_need;
CREATE TABLE job_need (
        id INTEGER PRIMARY KEY NOT NULL,
        job_definition_id INTEGER NOT NULL,
        need_job_definition_id INTEGER NOT NULL,
        need_state INTEGER DEFAULT 5,
        creation_time DEFAULT CURRENT_TIMESTAMP,
	FOREIGN KEY(job_definition_id) REFERENCES job_definition(id) ON UPDATE CASCADE ON DELETE CASCADE,
	FOREIGN KEY(need_job_definition_id) REFERENCES job_definition(id) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE UNIQUE INDEX job_need_idx1 ON job_need (job_definition_id, need_job_definition_id, need_state);
CREATE INDEX job_need_idx2 ON job_need (need_job_definition_id);

COMMIT;
