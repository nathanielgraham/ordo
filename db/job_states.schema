PRAGMA foreign_keys=OFF;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS job_states;
CREATE TABLE job_states (
        id INTEGER PRIMARY KEY NOT NULL,
        state varchar NOT NULL,
        creation_time NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX job_states_idx1 ON job_states (state);

INSERT INTO job_states (state) VALUES('pruned');
INSERT INTO job_states (state) VALUES('ready');
INSERT INTO job_states (state) VALUES('starting');
INSERT INTO job_states (state) VALUES('stopping');
INSERT INTO job_states (state) VALUES('running');
INSERT INTO job_states (state) VALUES('complete');
INSERT INTO job_states (state) VALUES('failed');
INSERT INTO job_states (state) VALUES('hold');
INSERT INTO job_states (state) VALUES('ice');
INSERT INTO job_states (state) VALUES('killed');
INSERT INTO job_states (state) VALUES('zombie');
INSERT INTO job_states (state) VALUES('waiting');
INSERT INTO job_states (state) VALUES('watching');
INSERT INTO job_states (state) VALUES('looping');
INSERT INTO job_states (state) VALUES('retrying');
INSERT INTO job_states (state) VALUES('immutable');
INSERT INTO job_states (state) VALUES('sleeping');

COMMIT;
