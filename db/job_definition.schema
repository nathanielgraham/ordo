PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS job_definition;
CREATE TABLE job_definition (
        id INTEGER PRIMARY KEY NOT NULL,
        workspace_id INTEGER,
        server_id INTEGER,
        remote_command varchar,
        name varchar,
        description varchar,
        out_log_path varchar,
        err_log_path varchar,
        restart_max INTEGER NOT NULL DEFAULT 0, 
        restart_delay INTEGER NOT NULL DEFAULT 0,
        creation_time DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(server_id) REFERENCES server(id),
        FOREIGN KEY(workspace_id) REFERENCES workspace(id)
);

CREATE UNIQUE INDEX job_definition_idx1 ON job_definition (workspace_id, name);

COMMIT;
