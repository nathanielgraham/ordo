PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS job_log;
CREATE TABLE job_log (
        id INTEGER PRIMARY KEY NOT NULL,
	job_id INTEGER REFERENCES job(id) ON DELETE CASCADE,
	log_id integer,
	ppid integer,
        started INTEGER,
        ended INTEGER,
	exit_code integer,
	signal integer,
        pid integer,
        creation_time integer DEFAULT (strftime('%s', 'now'))
);

CREATE UNIQUE INDEX job_log_idx1 ON job_log (job_id, log_id, ppid);

COMMIT;
