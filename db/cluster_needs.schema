PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS cluster_needs;
CREATE TABLE cluster_needs (
        id INTEGER PRIMARY KEY NOT NULL,
        cluster_id INTEGER REFERENCES cluster(id) ON DELETE CASCADE,
        needs_cluster_id INTEGER REFERENCES cluster(id) ON DELETE CASCADE,
        needs_any_mode INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX cluster_needs_idx1 ON cluster_needs (cluster_id, needs_cluster_id, needs_any_mode);

COMMIT;
