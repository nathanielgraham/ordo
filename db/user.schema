PRAGMA foreign_keys=OFF;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS user;
CREATE TABLE user (
        id INTEGER PRIMARY KEY NOT NULL,
	org_id INTEGER,
        level tinyint NOT NULL DEFAULT 1,
        token varchar,
        remote_address varchar,
        username varchar,
        email varchar,
        creation_time DEFAULT CURRENT_TIMESTAMP,
	FOREIGN KEY(org_id) REFERENCES org(id) ON UPDATE CASCADE ON DELETE CASCADE
);

INSERT INTO user (level, username, token) VALUES(99,'admin','1d53c9a4e58a0b76f4ab7ad900d8db7814f4d27e');

CREATE UNIQUE INDEX user_idx1 ON user (token);
COMMIT;
