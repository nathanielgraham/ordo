PRAGMA foreign_keys=on;
BEGIN TRANSACTION;
DROP TABLE IF EXISTS cal;
CREATE TABLE cal (
        id INTEGER PRIMARY KEY NOT NULL,
        org_id INTEGER REFERENCES org(id) ON DELETE CASCADE,
        name varchar,
        tz varchar not null,
        description varchar,
	updated_at integer,
        creation_time integer DEFAULT (strftime('%s', 'now'))
);

CREATE UNIQUE INDEX cal_idx1 ON cal (org_id, name);

COMMIT;
