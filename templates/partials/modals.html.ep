<!-- templates/partials/modals.html.ep -->

<!-- Login Modal -->
<div id="login-modal" class="app-modal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Sign in to Ordo</h3>
      <button class="close-btn" data-dismiss="login-modal"></button>
    </div>
    <div class="modal-body">
      <div id="login-form-container">
        <p class="text-center text-grey mb-large">
          We'll send you a magic login link.
        </p>

        <form id="login-form" novalidate>
          <div class="form-group">
            <label class="label-bold">Email Address</label>
            <input
              type="email"
              name="email"
              id="login-email"
              class="input"
              placeholder="you@example.com"
              required
            />
          </div>

          <!-- Legal Agreement -->
          <div class="legal-checkbox mt-large">
            <label class="flex items-center gap-small cursor-pointer">
              <input
                type="checkbox"
                id="agree-terms"
                name="agree_terms"
                required
              />
              <span class="text-grey text-small">
                I agree to the
                <a href="/terms" target="_blank" class="text-cyan"
                  >Terms of Service</a
                >
                and
                <a href="/privacy" target="_blank" class="text-cyan"
                  >Privacy Policy</a
                >
              </span>
            </label>
          </div>

          <div class="mt-large">
            <button
              type="submit"
              class="btn btn-primary w-full"
              id="send-magic-link-btn"
            >
              Send Magic Link
            </button>
          </div>
        </form>
      </div>

      <!-- Success State -->
      <div
        id="login-success"
        style="display: none; text-align: center; padding: 2rem 1rem"
      >
        <i class="fas fa-envelope fa-3x text-cyan mb-medium"></i>
        <h4>Check your inbox</h4>
        <p class="text-grey">
          We've sent you a magic login link.<br />It expires in 15 minutes.
        </p>
      </div>

      <!-- Error State -->
      <div
        id="login-error"
        style="
          display: none;
          text-align: center;
          padding: 1.5rem;
          color: #ef4444;
        "
      >
        <p id="login-error-text"></p>
      </div>
    </div>
  </div>
</div>
