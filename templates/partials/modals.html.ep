<!-- templates/partials/modals.html.ep -->

<!-- Login Modal -->
<div id="login-modal" class="app-modal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Sign in to Ordo</h3>
      <button class="close-btn"></button>
    </div>
    <div class="modal-body">
      <div id="login-form-container">
        <p class="text-center text-grey mb-large">
          We'll send you a magic login link.
        </p>

        <form id="login-form" action="/login" method="POST">
          <div class="form-group">
            <label class="label-bold">Email Address</label>
            <input
              type="email"
              name="email"
              id="login-email"
              class="input"
              placeholder="you@example.com"
              required
            />
          </div>

          <div class="mt-large">
            <button
              type="submit"
              class="btn btn-primary w-full"
              id="send-magic-link-btn"
            >
              Send Magic Link
            </button>
          </div>
        </form>
      </div>

      <div
        id="login-success"
        style="display: none; text-align: center; padding: 2rem 1rem"
      >
        <i class="fas fa-envelope fa-3x text-cyan mb-medium"></i>
        <h4>Check your inbox</h4>
        <p class="text-grey">
          We've sent you a magic login link.<br />It may take up to 30 seconds.
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Pricing Modal -->
<div id="pricing-modal" class="app-modal">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 class="modal-title">Plans & Pricing</h3>
      <button class="close-btn"></button>
    </div>

    <div class="modal-body">
      <div class="pricing-grid">
        <!-- Free -->
        <div class="plan-card" id="plan-free">
          <h4 class="title-medium">Free</h4>
          <div class="price-box">
            <span class="text-5xl font-bold">$0</span
            ><span class="text-grey">/mo</span>
          </div>
          <ul class="feature-list">
            <li>1,000 API calls/month</li>
            <li>1 Server</li>
            <li>1 Team Member</li>
            <li>Online docs</li>
          </ul>
          <button class="btn btn-ghost neon-ghost w-full mt-large" disabled>
            Current Plan
          </button>
        </div>

        <!-- Pro -->
        <div class="plan-card recommended" id="plan-pro">
          <h4 class="title-medium">Pro</h4>
          <div class="price-box">
            <span class="text-5xl font-bold">$79</span
            ><span class="text-grey">/mo</span>
          </div>
          <ul class="feature-list">
            <li>200,000 API calls/month</li>
            <li>10 Servers</li>
            <li>10 Team Members</li>
            <li>Email support</li>
          </ul>
          <button class="btn btn-primary w-full mt-large" data-plan="pro">
            Upgrade — $79/mo
          </button>
        </div>
      </div>

      <!-- Bottom CTA with generous space -->
      <div class="strong-cta">
        <a
          href="#docs/private-deployments"
          class="btn btn-ghost neon-ghost px-8 py-3 text-lg"
          id="view-private-options"
        >
          View Private &amp; Enterprise Options →
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Log Modal -->
<div id="log-modal" class="app-modal">
  <div class="modal-backdrop"></div>
  <div class="modal-dialog">
    <header class="modal-header">
      <p class="modal-title" id="log-modal-title">Latest Job Log</p>
      <p class="modal-subtitle" id="log-modal-subtitle"></p>
      <button class="close-btn" data-dismiss="log-modal"></button>
    </header>
    <section class="modal-body">
      <div id="log-loading" class="text-center py-large" style="display: none">
        <i class="fas fa-spinner fa-spin fa-2x"></i>
        <p class="mt-medium">Fetching latest log...</p>
      </div>
      <pre id="log-content" style="display: none"></pre>
    </section>
    <footer class="modal-footer">
      <button class="btn btn-secondary" id="view-history">View History</button>
      <button class="btn btn-secondary" id="refresh-log">Refresh Log</button>
      <button class="btn btn-primary" data-dismiss="log-modal">Close</button>
    </footer>
  </div>
</div>

<!-- Log History Modal -->
<div id="log-history-modal" class="app-modal">
  <div class="modal-backdrop"></div>
  <div class="modal-dialog">
    <header class="modal-header">
      <p class="modal-title">Job Log History</p>
      <button class="close-btn" data-dismiss="log-history-modal"></button>
    </header>
    <section class="modal-body">
      <div class="table-container">
        <table class="ordo-table" id="log-history-table">
          <thead>
            <tr>
              <th>Run ID</th>
              <th>Start Time</th>
              <th>Duration</th>
              <th>Exit Code</th>
            </tr>
          </thead>
          <tbody id="log-history-body"></tbody>
        </table>
      </div>
      <p
        id="no-history"
        class="text-grey text-center py-large"
        style="display: none"
      >
        No log history available.
      </p>
    </section>
    <footer class="modal-footer">
      <button class="btn btn-secondary" data-dismiss="log-history-modal">
        Close
      </button>
    </footer>
  </div>
</div>

<!-- Invite Team Member Modal -->
<div id="invite-modal" class="app-modal">
  <div class="modal-backdrop"></div>
  <div class="modal-dialog">
    <header class="modal-header">
      <p class="modal-title">Invite Team Member</p>
      <button class="close-btn" data-dismiss="invite-modal"></button>
    </header>
    <section class="modal-body">
      <div class="form-group">
        <label class="label" for="invite-email">Email Address</label>
        <input
          class="input"
          type="email"
          id="invite-email"
          placeholder="Enter email to invite"
        />
      </div>
    </section>
    <footer class="modal-footer">
      <button class="btn btn-secondary" data-dismiss="invite-modal">
        Cancel
      </button>
      <button class="btn btn-primary" id="send-invite">Send Invite</button>
    </footer>
  </div>
</div>

<!-- Confirmation Modal -->
<div id="confirm-modal" class="app-modal">
  <div class="modal-backdrop"></div>
  <div class="modal-dialog">
    <header class="modal-header">
      <p class="modal-title">Confirm Action</p>
      <button class="close-btn" data-dismiss="confirm-modal"></button>
    </header>
    <section class="modal-body">
      <p id="confirm-message">Are you sure you want to [action] [name]?</p>
    </section>
    <footer class="modal-footer">
      <button
        class="btn btn-secondary"
        id="confirm-no"
        data-dismiss="confirm-modal"
      >
        No
      </button>
      <button class="btn btn-danger" id="confirm-yes">Yes</button>
    </footer>
  </div>
</div>

<!-- Attach Calendar Modal -->
<div id="attach-calendar-modal" class="app-modal">
  <div class="modal-backdrop"></div>
  <div class="modal-dialog">
    <header class="modal-header">
      <p class="modal-title">Attach Calendar</p>
      <p class="modal-subtitle" id="attach-cluster-name">Select cluster...</p>
      <button class="close-btn" data-dismiss="attach-calendar-modal"></button>
    </header>
    <section class="modal-body">
      <div class="form-group">
        <label class="label" for="calendar-select">Calendar</label>
        <select
          id="calendar-select"
          placeholder="Select calendar or type to search..."
        ></select>
      </div>
    </section>
    <footer class="modal-footer">
      <button class="btn btn-secondary" data-dismiss="attach-calendar-modal">
        Cancel
      </button>
      <button class="btn btn-primary" id="save-attach-calendar">Save</button>
    </footer>
  </div>
</div>

<!-- Job Modal -->
<div id="job-modal" class="app-modal">
  <div class="modal-backdrop"></div>
  <div class="modal-dialog large">
    <header class="modal-header">
      <p class="modal-title" id="job-modal-title">New Job</p>
      <p class="modal-subtitle" id="job-context"></p>
      <button class="close-btn" data-dismiss="job-modal"></button>
    </header>
    <section class="modal-body">
      <div class="form-group">
        <label class="label required" for="job-name">Name</label>
        <input
          class="input"
          type="text"
          id="job-name"
          placeholder="e.g. nightly-backup"
        />
      </div>
      <!--
      <div class="form-group">
        <label class="label" for="job-description">Description</label>
        <textarea class="textarea" id="job-description" rows="2"></textarea>
      </div>
-->

      <div class="form-group">
        <div class="template-row">
          <label class="label" for="script-template">Insert Template</label>
          <select id="script-template" class="template-select">
            <option value="">— Choose Template —</option>
            <option value="shell">Shell Script</option>
            <option value="python">Python Script</option>
            <option value="perl">Perl Script</option>
            <option value="ruby">Ruby Script</option>
            <option value="stats">Update Stats</option>
            <option value="email">Email Team</option>
          </select>
        </div>

        <div class="script-wrapper">
          <textarea
            id="job-script"
            class="script-textarea"
            rows="10"
            placeholder="Enter your script here..."
          ></textarea>
          <button
            type="button"
            id="clear-script-btn"
            class="clear-script-btn"
            title="Clear script"
          >
            ×
          </button>
        </div>
      </div>

      <div class="form-group">
        <label class="label required" for="job-server">Server</label>
        <select id="job-server" placeholder="Select server..."></select>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="label" for="job-needs">Needs Jobs (blocking AND)</label>
          <select
            id="job-needs"
            placeholder="Select dependencies..."
            multiple
          ></select>
          <p class="help-text">Dependencies that must all complete first.</p>
        </div>
        <div class="form-group">
          <label class="label" for="job-needs-any">Needs Any Jobs (OR)</label>
          <select
            id="job-needs-any"
            placeholder="Select dependencies..."
            multiple
          ></select>
          <p class="help-text">
            Any one of these completing satisfies the dependency.
          </p>
        </div>
      </div>
      <!--
      <div class="form-group">
        <label class="label" for="job-on-fail">On Fail Cluster</label>
        <select id="job-on-fail">
          <option value="">None</option>
        </select>
      </div>
-->
      <div class="form-row">
        <div class="form-group">
          <label class="label"
            >Loops <span class="text-grey">(0 = run once)</span></label
          >
          <input class="input" type="number" id="job-loops" min="0" value="0" />
        </div>
        <div class="form-group">
          <label class="label">Retries</label>
          <input
            class="input"
            type="number"
            id="job-retrys"
            min="0"
            value="0"
          />
        </div>
        <div class="form-group">
          <label class="label">Delay (seconds)</label>
          <input class="input" type="number" id="job-delay" min="0" value="1" />
        </div>
      </div>
    </section>
    <footer class="modal-footer">
      <button class="btn btn-secondary" data-dismiss="job-modal">Cancel</button>
      <button class="btn btn-primary" id="save-job">Save</button>
    </footer>
  </div>
</div>

<!-- Cluster Modal -->
<div id="cluster-modal" class="app-modal">
  <div class="modal-backdrop"></div>
  <div class="modal-dialog large">
    <header class="modal-header">
      <p class="modal-title" id="cluster-modal-title">New Cluster</p>
      <p class="modal-subtitle" id="cluster-context"></p>
      <button class="close-btn" data-dismiss="cluster-modal"></button>
    </header>
    <section class="modal-body">
      <div class="form-group">
        <label class="label required" for="cluster-name">Name</label>
        <input
          class="input"
          type="text"
          id="cluster-name"
          placeholder="e.g. nightly-backups"
        />
        <p class="help-text">
          Short name — will be created in the selected parent cluster
        </p>
      </div>
      <div class="form-group">
        <label class="label" for="cluster-description">Description</label>
        <textarea class="textarea" id="cluster-description" rows="2"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="label" for="cluster-needs"
            >Needs Clusters (blocking AND)</label
          >
          <select
            id="cluster-needs"
            placeholder="Select dependencies..."
            multiple
          ></select>
          <p class="help-text">Dependencies that must all complete first.</p>
        </div>
        <div class="form-group">
          <label class="label" for="cluster-needs-any"
            >Needs Any Clusters (OR)</label
          >
          <select
            id="cluster-needs-any"
            placeholder="Select dependencies..."
            multiple
          ></select>
          <p class="help-text">
            Any one of these completing satisfies the dependency.
          </p>
        </div>
      </div>
      <div class="form-group">
        <label class="label" for="cluster-on-fail">On Fail Cluster</label>
        <select id="cluster-on-fail">
          <option value="">None</option>
        </select>
      </div>
      <div class="form-group">
        <label class="label"
          >Loops <span class="text-grey">(0 = run once)</span></label
        >
        <input
          class="input"
          type="number"
          id="cluster-loops"
          min="0"
          value="0"
        />
      </div>
      <div class="form-group">
        <label class="label">
          <input type="checkbox" id="cluster-clonable" />
          Clonable
        </label>
        <p class="help-text">
          If checked, starting a running cluster creates & starts an exact clone
          instead of erroring.
        </p>
      </div>
    </section>
    <footer class="modal-footer">
      <button class="btn btn-secondary" data-dismiss="cluster-modal">
        Cancel
      </button>
      <button class="btn btn-primary" id="save-cluster">Save</button>
    </footer>
  </div>
</div>

<!-- Graph Modal -->
<div id="graph-modal" class="app-modal">
  <div class="modal-backdrop"></div>
  <div class="modal-dialog full">
    <header class="modal-header">
      <p class="modal-title">
        Dependency Graph: <span id="graph-title"></span>
      </p>

      <!-- Zoom Controls (uses your existing CSS) -->
      <div class="zoom-controls">
        <button
          class="btn btn-sm btn-ghost"
          id="graph-fit-btn"
          title="Fit to Screen"
        >
          <i class="fas fa-expand"></i>
        </button>
        <button class="btn btn-sm btn-ghost" id="graph-zoom-in" title="Zoom In">
          <i class="fas fa-plus"></i>
        </button>
        <button
          class="btn btn-sm btn-ghost"
          id="graph-zoom-out"
          title="Zoom Out"
        >
          <i class="fas fa-minus"></i>
        </button>
        <button
          class="btn btn-sm btn-ghost"
          id="graph-reset"
          title="Reset View"
        >
          <i class="fas fa-undo"></i>
        </button>
      </div>

      <button class="close-btn" data-dismiss="graph-modal"></button>
    </header>
    <section class="modal-body graph-body">
      <div id="graph-container"></div>

      <div class="graph-legend">
        <!-- Your existing legend stays exactly the same -->
        <div class="graph-legend-title">Legend</div>
        <div class="legend-item">
          <svg width="60" height="14" class="legend-svg">
            <line
              x1="4"
              y1="7"
              x2="52"
              y2="7"
              stroke="#ff3366"
              stroke-width="3"
            />
            <polygon points="52,7 46,3 46,11" fill="#ff3366" />
          </svg>
          <span><strong>needs</strong> — must complete (AND)</span>
        </div>
        <div class="legend-item">
          <svg width="60" height="14" class="legend-svg">
            <line
              x1="4"
              y1="7"
              x2="52"
              y2="7"
              stroke="#00ff9d"
              stroke-width="3"
              stroke-dasharray="6,4"
            />
            <polygon points="52,7 46,3 46,11" fill="#00ff9d" />
          </svg>
          <span><strong>needs_any</strong> — any one is enough (OR)</span>
        </div>
        <div class="legend-item">
          <svg width="60" height="14" class="legend-svg">
            <line
              x1="4"
              y1="7"
              x2="52"
              y2="7"
              stroke="#ffaa00"
              stroke-width="3"
            />
            <polygon points="52,7 46,3 46,11" fill="#ffaa00" />
          </svg>
          <span><strong>on_fail</strong> — run if parent fails</span>
        </div>
      </div>
    </section>
  </div>
</div>
