<!-- partials/about.html.ep -->
<section id="about" class="tab-content" data-public="true">

  <!-- Hero -->
  <div class="hero-section">
    <div class="hero-content text-center">
      <h1 class="title-large">
        <i class="fas fa-briefcase mr-3"></i>Ordo
      </h1>
      <p class="subtitle-italic">Automation that feels like your filesystem</p>
      <h2 class="title-medium">The modern job scheduler<br />for teams and individuals</h2>
      <p class="subtitle-description">
        Hierarchical workflows • Real-time monitoring • Self-healing automation<br />
        Full Quartz scheduling • Easy migration from AutoSys/cron • Open core
      </p>
      <div class="hero-buttons">
        <a href="/login" class="btn btn-large btn-white">Get Started Free</a>
        <a href="#video" class="btn btn-large btn-white">Watch Video</a>
      </div>
    </div>
  </div>

  <!-- How It Works -->
  <div class="section">
    <div class="content-center">
      <h2 class="title-medium">How It Works</h2>
      <div class="grid-3">
        <div class="card-simple text-center">
          <span class="icon-large"><i class="fas fa-folder-plus"></i></span>
          <h3>1. Organize</h3>
          <p>Create clusters and jobs — just like folders and files.</p>
        </div>
        <div class="card-simple text-center">
          <span class="icon-large"><i class="fas fa-clock"></i></span>
          <h3>2. Schedule</h3>
          <p>Use calendars with extended cron syntax — daily, weekly, or "last Friday of the month".</p>
        </div>
        <div class="card-simple text-center">
          <span class="icon-large"><i class="fas fa-eye"></i></span>
          <h3>3. Monitor & Heal</h3>
          <p>Live updates + automatic recovery on failure.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Why Teams Love Ordo -->
  <div class="section bg-dark">
    <div class="content-center">
      <h2 class="title-medium">Why Teams Love Ordo</h2>
      <div class="grid-3">
        <div class="card-simple text-center">
          <span class="icon-large"><i class="fas fa-sitemap"></i></span>
          <h3>Hierarchical Workflows</h3>
          <p>Nest jobs in clusters like files in folders. Dependencies are natural.</p>
        </div>
        <div class="card-simple text-center">
          <span class="icon-large"><i class="fas fa-tachometer-alt"></i></span>
          <h3>Real-Time Monitoring</h3>
          <p>Live countdowns, performance charts, and historical trends.</p>
        </div>
        <div class="card-simple text-center">
          <span class="icon-large"><i class="fas fa-shield-alt"></i></span>
          <h3>Self-Healing Automation</h3>
          <p>On failure, run alerts, retries, or full recovery clusters.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Coming in v1 -->
  <div class="section">
    <div class="content-center">
      <h2 class="title-medium">Coming in v1</h2>
      <div class="grid-3">
        <div class="card-simple text-center">
          <span class="icon-large"><i class="fas fa-file-import"></i></span>
          <h3>Easy Migration</h3>
          <p>Import AutoSys JIL files or crontabs directly.</p>
        </div>
        <div class="card-simple text-center">
          <span class="icon-large"><i class="fas fa-chart-line"></i></span>
          <h3>Performance Insights</h3>
          <p>Historical CPU, memory, and duration charts for every job and server.</p>
        </div>
        <div class="card-simple text-center">
          <span class="icon-large"><i class="fas fa-project-diagram"></i></span>
          <h3>Dependency Graph</h3>
          <p>Interactive visualization of your entire workflow.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Video / Screenshot -->
  <div class="section bg-dark" id="video">
    <div class="content-center">
      <h2 class="title-medium">See Ordo in Action</h2>
      <div class="video-placeholder">
        <i class="fas fa-video fa-5x"></i>
        <p>2-Minute Overview Video</p>
        <p>Coming soon — or watch the tutorial series!</p>
      </div>
