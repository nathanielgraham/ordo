          >
        </p>
      </div>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section">
    <div class="container">
      <h2 class="title has-text-centered is-3 mb-6">How Ordo Compares</h2>
      <div class="table-container">
        <table
          class="table is-fullwidth is-bordered is-striped is-hoverable"
        >
          <thead class="has-background-primary">
            <tr>
              <th class="has-text-white">Feature</th>
              <th class="has-text-white">Legacy Tools</th>
              <th class="has-text-white">Cloud Schedulers</th>
              <th class="has-text-white has-background-success">Ordo</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Modern, real-time UI</td>
              <td>Outdated</td>
              <td>Good but complex</td>
              <td class="has-text-success">
                <strong>✓ Live updates</strong>
              </td>
            </tr>
            <tr>
              <td>Hierarchical organization</td>
              <td>Flat lists</td>
              <td>Good</td>
              <td class="has-text-success">
                <strong>✓ Native clusters</strong>
              </td>
            </tr>
            <tr>
              <td>Full Quartz scheduling</td>
              <td>Limited</td>
              <td>✓</td>
              <td class="has-text-success">
                <strong>✓ Advanced cron</strong>
              </td>
            </tr>
            <tr>
              <td>Self-healing</td>
              <td>Alerts only</td>
              <td>Alerts + retry</td>
              <td class="has-text-success">
                <strong>✓ Run recovery clusters</strong>
              </td>
            </tr>
            <tr>
              <td>Easy migration</td>
              <td>Manual pain</td>
              <td>Hard</td>
              <td class="has-text-success">
                <strong>✓ Import JIL/crontab</strong>
              </td>
            </tr>
            <tr>
              <td>Performance monitoring</td>
              <td>Limited</td>
              <td>Extra cost</td>
              <td class="has-text-success">
                <strong>✓ Historical charts</strong>
              </td>
            </tr>
            <tr>
              <td>Dependency visualization</td>
              <td>No</td>
              <td>Yes</td>
              <td class="has-text-success">
                <strong>✓ Interactive graph</strong>
              </td>
            </tr>
            <tr>
              <td>Pricing</td>
              <td>$50k–$500k+</td>
              <td>SaaS subscription</td>
              <td class="has-text-success">
                <strong>✓ Free tier + $39/mo</strong>
              </td>
            </tr>
            <tr>
              <td>No lock-in</td>
              <td>Proprietary</td>
              <td>Cloud vendor</td>
              <td class="has-text-success">
                <strong>✓ Open core</strong>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="has-text-centered mt-4">
        <small
          >Pricing: Free forever self-hosted • $39/month Pro tier • Custom
          enterprise options</small
        >
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section
    class="hero is-primary"
    style="background: linear-gradient(135deg, #00c9b1, #007a87)"
  >
    <div class="hero-body has-text-centered">
      <h2 class="title has-text-white is-3">
        Ready to simplify your automation?
      </h2>
      <p class="subtitle has-text-white mb-6">
        Free tier available • $39/month Pro • Custom plans for special
