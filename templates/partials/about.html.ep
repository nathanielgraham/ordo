<!-- partials/about.html.ep -->
<section id="about" class="tab-content" data-public="true">
  <!-- Hero -->
  <section
    class="hero is-medium is-primary"
    style="background: linear-gradient(135deg, #00c9b1, #007a87)"
  >
    <div class="hero-body">
      <div class="container has-text-centered">
        <!-- Logo Placeholder -->
        <h1 class="title is-1 has-text-white mb-3">
          <i class="fas fa-briefcase mr-3"></i>Ordo
        </h1>
        <p class="subtitle has-text-white is-italic is-size-5 mb-5">
          Automation that feels like your filesystem
        </p>
        <h2 class="title has-text-white is-3 mb-5">
          The modern job scheduler<br />for teams and individuals
        </h2>
        <p
          class="subtitle has-text-white is-5 mb-6"
          style="max-width: 800px; margin: 0 auto"
        >
          Hierarchical workflows • Real-time monitoring • Self-healing
          automation<br />
          Full Quartz scheduling • Easy migration from AutoSys/cron • Open
          core
        </p>
        <div class="buttons is-centered">
          <a href="/login" class="button is-large is-white is-outlined">
            <strong>Get Started Free</strong>
          </a>
          <a
            href="#video"
            class="button is-large is-white is-outlined ml-4"
          >
            Watch Video
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section">
    <div class="container">
      <h2 class="title has-text-centered is-3 mb-6">How It Works</h2>
      <div class="columns is-centered">
        <div class="column is-one-third">
          <div class="has-text-centered">
            <span class="icon is-large has-text-primary mb-4"
              ><i class="fas fa-folder-plus fa-3x"></i
            ></span>
            <h3 class="title is-5">1. Organize</h3>
            <p>Create clusters and jobs — just like folders and files.</p>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="has-text-centered">
            <span class="icon is-large has-text-primary mb-4"
              ><i class="fas fa-clock fa-3x"></i
            ></span>
            <h3 class="title is-5">2. Schedule</h3>
            <p>
              Use calendars with extended cron syntax — daily, weekly, or
              "last Friday of the month".
            </p>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="has-text-centered">
            <span class="icon is-large has-text-primary mb-4"
              ><i class="fas fa-eye fa-3x"></i
            ></span>
            <h3 class="title is-5">3. Monitor & Heal</h3>
            <p>Live updates + automatic recovery on failure.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Benefits -->
  <section class="section has-background-light">
    <div class="container">
      <h2 class="title has-text-centered is-3 mb-6">
        Why Teams Love Ordo
      </h2>
      <div class="columns is-multiline is-centered">
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content has-text-centered">
              <span class="icon is-large has-text-primary mb-4"
                ><i class="fas fa-sitemap fa-3x"></i
              ></span>
              <h3 class="title is-5">Hierarchical Workflows</h3>
              <p>
                Nest jobs in clusters like files in folders. Dependencies
                are natural — add explicit ones for precision.
              </p>
            </div>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content has-text-centered">
              <span class="icon is-large has-text-primary mb-4"
                ><i class="fas fa-tachometer-alt fa-3x"></i
              ></span>
              <h3 class="title is-5">Real-Time Monitoring</h3>
              <p>
                Live countdowns, performance charts, and historical
                trends.
              </p>
            </div>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content has-text-centered">
              <span class="icon is-large has-text-primary mb-4"
                ><i class="fas fa-shield-alt fa-3x"></i
              ></span>
              <h3 class="title is-5">Self-Healing Automation</h3>
              <p>
                On failure, run alerts, retries, or full recovery
                clusters.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coming in v1 Teaser -->
  <section class="section">
    <div class="container">
      <h2 class="title has-text-centered is-3 mb-6">Coming in v1</h2>
      <div class="columns is-multiline is-centered">
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content has-text-centered">
              <span class="icon is-large has-text-info mb-4"
                ><i class="fas fa-file-import fa-3x"></i
              ></span>
              <h3 class="title is-5">Easy Migration</h3>
              <p>
                Import AutoSys JIL files or crontabs directly — escape
                legacy systems fast.
              </p>
            </div>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content has-text-centered">
              <span class="icon is-large has-text-info mb-4"
                ><i class="fas fa-chart-line fa-3x"></i
              ></span>
              <h3 class="title is-5">Performance Insights</h3>
              <p>
                Historical CPU, memory, and duration charts for every job
                and server.
              </p>
            </div>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content has-text-centered">
              <span class="icon is-large has-text-info mb-4"
                ><i class="fas fa-project-diagram fa-3x"></i
              ></span>
              <h3 class="title is-5">Dependency Graph</h3>
              <p>Interactive visualization of your entire workflow.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Screenshot / Video -->
  <section class="section has-background-light" id="video">
    <div class="container">
      <h2 class="title has-text-centered is-3 mb-6">
        See Ordo in Action
      </h2>
      <div class="has-text-centered">
        <!-- Video Placeholder -->
        <div
          class="box"
          style="
            max-width: 900px;
            margin: 0 auto;
            background: #f0f0f0;
            height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
          "
        >
          <i class="fas fa-video fa-5x has-text-grey mb-4"></i>
          <p class="title is-5">2-Minute Overview Video</p>
          <p class="subtitle has-text-grey">
            Coming soon — or watch the tutorial series!
          </p>
        </div>
        <!-- Screenshot Suggestion -->
        <p class="mt-5 subtitle has-text-grey">
          <em
            >Screenshot suggestion: Jobs & Clusters view with live
