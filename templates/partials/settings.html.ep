<!-- partials/settings.html.ep -->
<section id="settings" class="tab-content" data-private="true">
  <div class="settings-wrapper">
    <div id="settings-loading" class="text-center py-large">
      <i class="fas fa-spinner fa-spin fa-3x"></i>
      <p class="mt-medium">Loading settings...</p>
    </div>

    <div id="settings-content">
      <!-- Internal Tabs -->
      <div class="internal-tabs">
        <button class="internal-tab active" data-tab="account">Account</button>
        <button class="internal-tab" data-tab="team">Members</button>
        <% if ($c->is_saas) { %>
        <button class="internal-tab" data-tab="billing">Billing</button>
        <% } %>
      </div>

      <!-- Scrollable Content Area -->
      <div class="settings-content-area">
        <!-- Account Tab -->
        <div id="tab-account" class="internal-tab-content active">
          <div class="card-simple">
            <h3 class="title-medium"><i class="fas fa-user"></i> Account</h3>
            <div class="info-grid">
              <div class="label-bold">Email</div>
              <div id="account-email"></div>
              <div class="label-bold">User ID</div>
              <div id="account-id"></div>
              <div class="label-bold">Level</div>
              <div id="account-level"></div>
              <div class="label-bold">Name</div>
              <input
                class="input"
                type="text"
                id="edit-name"
                placeholder="Your name"
              />
              <div class="label-bold">Remote Address</div>
              <div id="account-remote"></div>
              <div class="label-bold">Token (API)</div>
              <div class="token-row flex items-center gap-3">
                <input
                  class="input flex-1"
                  type="text"
                  id="account-token"
                  readonly
                />
                <button class="btn btn-ghost neon-ghost" id="copy-token">
                  <i class="fas fa-copy"></i> Copy
                </button>
                <button
                  class="btn btn-ghost neon-red-ghost"
                  id="regenerate-token"
                >
                  <i class="fas fa-redo"></i> Rotate
                </button>
              </div>
            </div>
            <div class="border-top mt-large pt-large">
              <h4 class="title-medium">
                <i class="fas fa-building"></i> Organization
              </h4>
              <div class="info-grid">
                <div class="label-bold">Org ID</div>
                <div id="org-id"></div>
                <div class="label-bold">Organization Name</div>
                <input
                  class="input"
                  type="text"
                  id="edit-org-name"
                  placeholder="Organization name"
                />
                <div class="label-bold">Description</div>
                <textarea
                  class="textarea"
                  id="edit-org-desc"
                  rows="3"
                  placeholder="Organization description"
                ></textarea>
                <!-- Execution Token -->
                <div class="label-bold">Execution Token</div>
                <div class="token-row flex items-center gap-3">
                  <input
                    class="input flex-1"
                    type="text"
                    id="execution-token"
                    readonly
                  />
                  <button
                    class="btn btn-ghost neon-red-ghost"
                    id="rotate-exec-token"
                  >
                    <i class="fas fa-redo"></i> Rotate
                  </button>
                </div>
              </div>
              <p class="help-text small mt-small text-orange">
                <strong>Warning:</strong> Rotating this token may disrupt
                currently running jobs. It is safest to rotate when no jobs are
                active.
              </p>
            </div>
            <!-- Danger Zone -->
            <div class="danger-zone">
              <h4><i class="fas fa-skull-crossbones"></i> Danger Zone</h4>
              <p>
                <strong>Warning:</strong> This action is permanent and cannot be
                undone. Your account, all jobs, clusters, calendars, and data
                will be permanently deleted.
              </p>
              <button id="delete-my-account" class="btn btn-danger w-full">
                <i class="fas fa-trash"></i> Delete My Account
              </button>
            </div>
            <div class="actions-right mt-large">
              <button class="btn btn-primary" id="save-account">
                <i class="fas fa-save"></i> Save Account
              </button>
            </div>
          </div>
        </div>
        <!-- Members Tab -->
        <div id="tab-team" class="internal-tab-content">
          <div class="card-simple">
            <div class="actions-right saas-only">
              <button class="btn btn-ghost neon-ghost" id="invite-team">
                <i class="fas fa-user-plus"></i> Invite Team Member
              </button>
            </div>
            <form id="create-user-form" class="selfhosted-only" style="margin-bottom:1rem;">
              <div class="form-group">
                <label for="new-user-name">Name</label>
                <input id="new-user-name" name="name" class="input" required placeholder="Alice">
              </div>
              <div class="form-group">
                <label for="new-user-email">Email</label>
                <input id="new-user-email" name="email" type="email" class="input" required placeholder="alice@example.com">
              </div>
              <div class="form-group">
                <label for="new-user-org">Organization</label>
                <select id="new-user-org" class="input">
                  <option value="same" selected>Add to my org (shared job tree)</option>
                  <option value="new">New org (own job tree)</option>
                </select>
              </div>
              <button type="submit" class="btn btn-primary">Create user</button>
              <div id="new-user-result" style="display:none; margin-top:1rem;">
                <div class="form-group">
                  <label>API token</label>
                  <div style="display:flex; gap:0.5rem;">
                    <input id="new-user-token" class="input" readonly>
                    <button type="button" class="btn btn-ghost" data-copy="new-user-token">Copy</button>
                  </div>
                </div>
                <div class="form-group">
                  <label>One-time login link</label>
                  <div style="display:flex; gap:0.5rem;">
                    <input id="new-user-link" class="input" readonly>
                    <button type="button" class="btn btn-ghost" data-copy="new-user-link">Copy</button>
                  </div>
                </div>
              </div>
            </form>
            <div class="table-container">
              <table class="ordo-table" id="team-table">
                <thead>
                  <tr>
                    <th>Email</th>
                    <th>User ID</th>
                    <th>Role</th>
                    <th>Created</th>
                  </tr>
                </thead>
                <tbody id="team-body"></tbody>
              </table>
            </div>
            <div
              id="no-team"
              class="empty-state text-center py-large"
              style="display: none"
            >
              <i class="fas fa-users-slash fa-5x has-text-grey"></i>
              <p class="has-text-grey-light mt-medium">
                No team members yet.<br />Invite someone to collaborate.
              </p>
            </div>
          </div>
        </div>
        <!-- Billing Tab (SaaS only) -->
        <div id="tab-billing" class="internal-tab-content">
          <div class="card-simple">
            <div class="flex justify-between items-start mb-large">
              <div>
                <h3 class="title-medium">
                  <i class="fas fa-credit-card"></i> Billing & Usage
                </h3>
              </div>
              <div class="actions-right flex gap-3">
                <button class="btn btn-primary" id="manage-subscription">
                  <i class="fas fa-cog"></i> Manage Subscription & Invoices
                </button>
                <button class="btn btn-ghost neon-ghost" id="view-plans-btn">
                  <i class="fas fa-arrow-up"></i> View Plans & Upgrade
                </button>
              </div>
            </div>
            <div class="info-grid">
              <div class="label-bold">Subscription Tier</div>
              <p id="account-tier" class="text-cyan font-bold"></p>
              <div class="label-bold">API Calls This Month</div>
              <div>
                <progress
                  id="api-progress"
                  class="progress w-full"
                  value="0"
                  max="100"
                ></progress>
                <p id="api-usage-text" class="text-grey"></p>
              </div>
              <div class="label-bold">Next Reset Date</div>
              <div id="api-period"></div>
              <div class="label-bold">Servers</div>
              <div id="server-usage-text"></div>
              <div class="label-bold">Team Members</div>
              <div id="team-usage-text"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
