<!-- partials/settings.html.ep -->
<section id="settings" class="tab-content" data-private="true">
  <div class="content-center">

    <div id="settings-loading" class="text-center py-large">
      <i class="fas fa-spinner fa-spin fa-3x"></i>
      <p class="mt-medium">Loading settings...</p>
    </div>

    <div id="settings-content" style="display: none">

      <!-- Refresh Button -->
      <div class="actions-right" style="margin-bottom: 2rem;">
        <button id="refresh-settings" class="btn btn-ghost neon-ghost">
          <i class="fas fa-sync-alt"></i> Refresh
        </button>
      </div>

      <!-- Internal Tabs -->
      <div class="internal-tabs">
        <button class="internal-tab active" data-tab="account-tab">Account</button>
        <button class="internal-tab" data-tab="team">Members</button>
        <button class="internal-tab" data-tab="billing">Billing</button>
      </div>

      <!-- Account Tab -->
      <div id="tab-account-tab" class="internal-tab-content">
        <div class="card-simple">
          <h3 class="title-medium">
            <i class="fas fa-user"></i> Account
          </h3>

          <div class="info-grid">
            <div class="label-bold">Email</div>
            <div id="account-email"></div>

            <div class="label-bold">User ID</div>
            <div id="account-id"></div>

            <div class="label-bold">Level</div>
            <div id="account-level"></div>

            <div class="label-bold">Name</div>
            <input class="input" type="text" id="edit-name" placeholder="Your name" />

            <div class="label-bold">Remote Address</div>
            <div id="account-remote"></div>

            <div class="label-bold">Token (API)</div>
            <div class="token-row" style="grid-column: 2 / -1;">
              <input class="input" type="text" id="account-token" readonly />
              <button class="btn btn-ghost neon-ghost" id="copy-token" style="white-space: nowrap;">
                <i class="fas fa-copy"></i> Copy
              </button>
            </div>
          </div>

          <div class="border-top" style="padding-top: 2.5rem; margin-top: 2rem;">
            <h4 class="title-medium">
              <i class="fas fa-building"></i> Organization
            </h4>
            <div class="info-grid">
              <div class="label-bold">Org ID</div>
              <div id="org-id"></div>

              <div class="label-bold">Organization Name</div>
              <input class="input" type="text" id="edit-org-name" placeholder="Organization name" />

              <div class="label-bold description-row">Description</div>
              <textarea class="textarea" id="edit-org-desc" rows="3" placeholder="Organization description"></textarea>
            </div>
          </div>

          <div class="actions-right" style="margin-top: 2.5rem;">
            <button class="btn btn-primary" id="save-account">
              <i class="fas fa-save"></i> Save Account
            </button>
          </div>
        </div>
      </div>

      <!-- Members Tab -->
      <div id="tab-team" class="internal-tab-content" style="display:none">
        <div class="card-simple">
          <div class="actions-right">
            <button class="btn btn-ghost neon-ghost" id="invite-team">
              <i class="fas fa-user-plus"></i> Invite Team Member
            </button>
          </div>

          <div class="table-container">
            <table class="ordo-table" id="team-table">
              <thead>
                <tr>
                  <th>Email</th>
                  <th>User ID</th>
                  <th>Role</th>
                  <th>Created</th>
                </tr>
              </thead>
              <tbody id="team-body"></tbody>
            </table>
          </div>

          <p id="no-team" class="text-grey text-center py-large" style="display: none; border: 2px dashed #444; padding: 3rem; margin-top: 2rem;">
            <i class="fas fa-users-slash fa-3x"></i><br><br>
            No team members yet.<br>
            Invite someone to collaborate.
          </p>
        </div>
      </div>

      <!-- Billing Tab -->
      <div id="tab-billing" class="internal-tab-content" style="display:none">
        <div class="card-simple">
          <h3 class="title-medium">
            <i class="fas fa-credit-card"></i> Billing & Usage
          </h3>

          <div class="info-grid" style="margin-bottom: 2rem;">
            <div class="label-bold">Subscription Tier</div>
            <p id="account-tier" style="margin: 0; font-weight: 700; color: var(--glow-cyan); text-transform: uppercase;"></p>
          </div>

          <div class="info-grid" style="margin-bottom: 2rem;">
            <div class="label-bold">API Calls This Month</div>
            <div>
              <div class="progress-container" style="margin: 0.5rem 0 0.75rem 0;">
                <progress id="api-progress" class="progress w-full" value="0" max="100">0%</progress>
              </div>
              <p id="api-usage-text" class="text-grey">0 / 1,000</p>
              <p id="api-period" class="text-cyan" style="margin-top: 0.5rem;">Current period: —</p>
            </div>
          </div>

          <div class="info-grid">
            <div class="label-bold">Servers</div>
            <div id="server-usage-text">0 / 3</div>

            <div class="label-bold">Team Members</div>
            <div id="team-usage-text">0 / 2</div>
          </div>

          <div class="border-top" style="padding-top: 2.5rem; margin-top: 2.5rem;">
            <h5 class="title-medium">Subscription Management (Stripe)</h5>
            <p class="text-grey">Next Billing Date: —</p>
            <p class="text-grey">Payment Method: —</p>
            <button class="btn btn-ghost neon-ghost" disabled style="margin-top: 1.5rem;">
              Manage Subscription & Invoices
            </button>
          </div>


          <div class="actions-right" style="margin-top: 2.5rem;">
            <button class="btn btn-ghost neon-ghost" id="view-plans-btn">
              <i class="fas fa-arrow-up"></i> View Plans & Upgrade
            </button>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
