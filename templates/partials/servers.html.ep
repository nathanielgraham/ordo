<!-- partials/servers.html.ep -->
<section id="servers" class="tab-content" data-private="true">
  <div class="content-center">
    <div id="servers-loading" class="text-center">
      <i class="fas fa-spinner fa-spin"></i> Loading...
    </div>

    <div id="servers-content" style="display: none">
      <div class="table-container">
        <table class="data-table" id="servers-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Status</th>
              <th>Load</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="servers-body"></tbody>
        </table>
      </div>
    </div>
  </div>
</section>
