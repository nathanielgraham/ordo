<!-- partials/servers.html.ep -->
<section id="servers" class="tab-content" data-private="true">
  <div class="container">
    <div id="servers-loading" class="has-text-centered">
      <i class="fas fa-spinner fa-spin"></i> Loading...
    </div>
    <div id="servers-content" style="display: none">
      <div class="table-container">
        <table class="table is-fullwidth is-hoverable is-striped" id="servers-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Status</th>
              <th>Load</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="servers-body"></tbody>
        </table>
      </div>
    </div>
  </div>
</section>
