<!-- partials/account.html.ep -->
<section id="account" class="tab-content" data-private="true">
  <div class="container">
    <div id="account-loading" class="has-text-centered">
      <i class="fas fa-spinner fa-spin"></i> Loading...
    </div>
    <div id="account-content" style="display: none">
      <div class="columns is-multiline">
        <div class="column is-6">
          <div class="card">
            <header class="card-header">
              <p class="card-header-title">
                <i class="fas fa-user mr-2"></i> Your Profile
              </p>
            </header>
            <div class="card-content">
              <div class="columns is-multiline">
                <div class="column is-half">
                  <p class="has-text-weight-bold">Email</p>
                  <p id="account-email"></p>
                </div>
                <div class="column is-half">
                  <p class="has-text-weight-bold">User ID</p>
                  <p id="account-id"></p>
                </div>
                <div class="column is-half">
                  <p class="has-text-weight-bold">Level</p>
                  <p id="account-level"></p>
                </div>
                <div class="column is-half">
                  <p class="has-text-weight-bold">Name</p>
                  <input
                    class="input"
                    type="text"
                    id="edit-name"
                    placeholder="Your name"
                  />
                </div>
                <div class="column is-half">
                  <p class="has-text-weight-bold">Mode (permissions)</p>
                  <input
                    class="input"
                    type="text"
                    id="edit-mode"
                    placeholder="770"
                  />
                </div>
                <div class="column is-half">
                  <p class="has-text-weight-bold">Creation Time</p>
                  <p id="account-creation"></p>
                </div>
                <div class="column is-half">
                  <p class="has-text-weight-bold">Last Update</p>
                  <p id="account-update"></p>
                </div>
                <div class="column is-half">
                  <p class="has-text-weight-bold">Remote Address</p>
                  <p id="account-remote"></p>
                </div>
                <div class="column is-full">
                  <p class="has-text-weight-bold">
                    Token (for API calls)
                  </p>
                  <div class="field has-addons">
                    <div class="control is-expanded">
                      <input
                        class="input"
                        type="text"
                        id="account-token"
                        readonly
                      />
                    </div>
                    <div class="control">
                      <button class="button is-info" id="copy-token">
                        <i class="fas fa-copy"></i> Copy
                      </button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="has-text-right mt-4">
                <button class="button is-primary" id="save-profile">
                  <i class="fas fa-save mr-2"></i> Save Profile
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="column is-6">
          <div class="card">
            <header class="card-header">
              <p class="card-header-title">
                <i class="fas fa-building mr-2"></i> Organization
              </p>
            </header>
            <div class="card-content">
              <div class="columns is-multiline">
                <div class="column is-half">
                  <p class="has-text-weight-bold">Org ID</p>
                  <p id="org-id"></p>
                </div>
                <div class="column is-half">
                  <p class="has-text-weight-bold">Name</p>
                  <input
                    class="input"
                    type="text"
                    id="edit-org-name"
                    placeholder="Organization name"
                  />
                </div>
                <div class="column is-full">
                  <p class="has-text-weight-bold">Description</p>
                  <textarea
                    class="textarea"
                    id="edit-org-desc"
                    placeholder="Organization description"
                  ></textarea>
                </div>
                <div class="column is-half">
                  <p class="has-text-weight-bold">Creation Time</p>
                  <p id="org-creation"></p>
                </div>
              </div>
              <div class="has-text-right mt-4">
                <button class="button is-primary" id="save-org">
                  <i class="fas fa-save mr-2"></i> Save Organization
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="card mt-6">
        <header class="card-header">
          <p class="card-header-title">
            <i class="fas fa-users mr-2"></i> Team Members
          </p>
        </header>
        <div class="card-content">
          <table class="table is-fullwidth is-striped" id="team-table">
            <thead>
              <tr>
                <th>Email</th>
                <th>ID</th>
                <th>Level</th>
                <th>Creation Time</th>
              </tr>
            </thead>
            <tbody id="team-body"></tbody>
          </table>
          <p id="no-team" class="has-text-grey" style="display: none">
            No team members yet.
          </p>
          <div class="mt-4">
            <button class="button is-success" id="invite-team">
              <i class="fas fa-user-plus mr-2"></i> Invite Team Member
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
