<!-- partials/jobs_clusters.html.ep -->
<section id="monitor" class="tab-content" data-private="true">
  <div class="content-center">

    <!-- Loading state -->
    <div id="monitor-loading" class="text-center py-large">
      <i class="fas fa-spinner fa-spin fa-3x"></i>
      <p class="mt-medium">Loading jobs & clusters...</p>
    </div>

    <div id="monitor-content" style="display: none">
      <div class="table-container">
        <table class="ordo-table ordo-table--tree" id="tree-table" role="treegrid" aria-label="Jobs and Clusters Hierarchy">
          <thead>
            <tr>
              <th>Path</th>
              <th>State</th>
              <th>Server</th>
              <th>Deps</th>
              <th>Stats</th>
              <th>Last Run</th>
              <th>Duration</th>
              <th>Next Run</th>
              <th>Calendar</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="tree-body"></tbody>
        </table>
      </div>
    </div>
  </div>
</section>
