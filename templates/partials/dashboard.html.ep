<section id="dashboard" class="tab-content" data-private="true">
  <div class="content-center text-center py-large">
    <h1 class="title-large">
      <i class="fas fa-tachometer-alt mr-2"></i> Dashboard
    </h1>
    <p class="subtitle-medium mt-medium">
      Your quick overview — coming soon!
    </p>
    <div class="card-simple mt-large max-w-2xl mx-auto">
      <p class="text-grey">
        This tab will show key stats like API usage, running jobs, failed jobs last hour, upcoming runs, and server health.
