              <td>SaaS subscription</td>
              <td class="has-text-success"><strong>✓ Free tier + $39/mo</strong></td>
            </tr>
            <tr>
              <td>No lock-in</td>
              <td>Proprietary</td>
              <td>Cloud vendor</td>
              <td class="has-text-success"><strong>✓ Open core</strong></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="has-text-centered mt-4">
        <small>Pricing: Free forever self-hosted • $39/month Pro tier • Custom enterprise options</small>
      </p>
    </div>
  </section>

