<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ordo — Job Scheduler</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<!-- Working browser bundle (includes common languages) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

<!-- Dark theme -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />/

    <style>
      /* Global & Layout */
      html {
        scroll-behavior: smooth;
      }
      .table-container {
        overflow: visible !important;
        position: relative;
      }

      /* Tree Table */
      .ordo-tree-table {
        width: 100%;
        border-collapse: collapse;
      }
      .ordo-tree-table th,
      .ordo-tree-table td {
        padding: 8px 12px;
        border-bottom: 1px solid #ddd;
        text-align: left;
      }
      .ordo-tree-table tr {
        --depth: 0;
      }
      .ordo-tree-table td:first-child {
        padding-left: calc(var(--depth) * 20px + 32px) !important;
      }

      /* Toggle Arrows */
      .ordo-toggle {
        cursor: pointer;
        display: inline-block;
        width: 24px;
        margin-right: 8px;
        text-align: center;
        font-size: 1em;
        color: #363636;
        transition: transform 0.2s ease;
      }
      .ordo-cluster-row:not(.collapsed) .ordo-toggle::before {
        content: "\f078"; /* fa-chevron-down */
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
      }
      .ordo-cluster-row.collapsed .ordo-toggle::before {
        content: "\f054"; /* fa-chevron-right */
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
      }

      /* Row Types */
      .ordo-cluster-row {
        background: rgba(33, 150, 243, 0.04);
      }
      .ordo-job-row {
        background: transparent;
      }

      /* Hidden Rows */
      tr[data-hidden="true"] {
        display: none !important;
      }

      /* State Colors */
      .ordo-state {
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
        display: inline-block;
        text-transform: capitalize;
      }
      .ordo-complete {
        color: #28a745;
      }
      .ordo-immutable {
        color: #17a2b8;
      }
      .ordo-running {
        color: #6f42c1;
      }
      .ordo-failed {
        color: #dc3545;
        font-weight: 700;
      }
      .ordo-ready {
        color: #ffc107;
      }
      .ordo-default {
        color: #6c757d;
      }

      @media (prefers-color-scheme: dark) {
        .ordo-complete {
          color: #4cd964;
          background: #4cd9641f;
        }
        .ordo-immutable {
          color: #4dd0e1;
          background: #4dd0e11f;
        }
        .ordo-running {
          color: #9f7aea;
          background: #9f7aea1f;
        }
        .ordo-failed {
          color: #ff6b6b;
          background: #ff6b6b26;
        }
        .ordo-ready {
          color: #ffdd57;
          background: #ffdd571f;
        }
        .ordo-default {
          color: #adb5bd;
          background: #adb5bd14;
        }
      }

      /* Mobile Adjustments */
      @media (max-width: 768px) {
        .table {
          font-size: 0.85rem;
        }
        .table th,
        .table td {
          padding: 6px 8px;
        }
        .ordo-toggle {
          font-size: 0.9em;
          width: 20px;
        }
      }

/* Docs Grid Layout (Sticky Sidebar - Reliable with Grid) */
.docs-grid {
  display: grid;
  grid-template-columns: 1fr 3fr; /* sidebar ~25%, content ~75% */
  height: calc(100vh - 3.5rem); /* full height minus navbar */
}

/* Sticky Sidebar */
.docs-sidebar {
  background: #1e1e1e;
  height: 100%;
  overflow-y: auto;
  position: sticky;
  top: 0;
  align-self: start;
}

/* Main Content Area */
.docs-content-container {
  overflow-y: auto;
  background: #f8f8f8;
}

/* TOC Link Styles */
#docs-toc a {
  color: #ddd !important;
  padding: 0.5rem 1rem;
  border-radius: 4px;
  transition: all 0.2s;
  display: block;
}

#docs-toc a:hover {
  background: rgba(255,255,255,0.1);
  color: white !important;
}

#docs-toc a.is-active {
  background: #3273dc;
  color: white !important;
  font-weight: bold;
}

/* Mobile: Stack vertically */
@media (max-width: 768px) {
  .docs-grid {
    grid-template-columns: 1fr;
  }
  .docs-sidebar {
    height: auto;
    max-height: 300px;
    position: relative;
  }
}

/* Optional: Subtle scrollbar in sidebar */
.docs-sidebar::-webkit-scrollbar {
  width: 6px;
}
.docs-sidebar::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.3);
  border-radius: 3px;
}


      /* Dropdowns */
      .dropdown {
        position: relative;
        display: inline-block;
      }
      .dropdown-trigger button {
        padding: 8px 12px;
        line-height: 1;
        border-radius: 50%;
        transition: background-color 0.2s;
      }
      .dropdown-trigger button:hover {
        background-color: rgba(0, 0, 0, 0.1);
      }

      .dropdown-menu {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-65%); /* shift left a bit more than 50% */
        min-width: 180px;
        max-height: 60vh; /* cap height */
        overflow-y: auto; /* scroll if needed */
        overflow-x: hidden;
        z-index: 1000;
        background: white;
        border: 1px solid #ddd;
        border-radius: 6px;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
        display: none;
        padding: 8px 0;
      }

      /* Flip upward when needed */
      .dropdown.is-up .dropdown-menu {
        top: auto;
        bottom: 100%;
        margin-bottom: 8px;
      }

      .dropdown.is-active .dropdown-menu {
        display: block !important;
      }

      .dropdown-item.disabled {
        color: #999;
        pointer-events: none;
        cursor: not-allowed;
        opacity: 0.6;
      }

      /* Nice scrollbar */
      .dropdown-menu::-webkit-scrollbar {
        width: 8px;
      }
      .dropdown-menu::-webkit-scrollbar-track {
        background: transparent;
      }
      .dropdown-menu::-webkit-scrollbar-thumb {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 4px;
      }
      .dropdown-menu::-webkit-scrollbar-thumb:hover {
        background: rgba(0, 0, 0, 0.5);
      }

      /* Modal Footer */
      .modal-card-foot-spaced {
        gap: 0.75rem;
        padding: 1rem;
      }
      @media (max-width: 768px) {
        .modal-card-foot-spaced {
          flex-direction: column;
          gap: 0.5rem;
        }
        .modal-card-foot-spaced .button {
          width: 100%;
        }
      }

      /* Multi-select styling */
      select[multiple] {
        height: 160px;
        padding: 8px;
        background: white;
      }
      select[multiple] option {
        padding: 6px 10px;
      }
      select[multiple] option:checked {
        background: #3273dc linear-gradient(0deg, #3273dc 0%, #3273dc 100%);
        color: white;
      }

      /* Single select full width */
      select.is-fullwidth {
        width: 100%;
      }

      /* Accessibility */
      a:focus,
      button:focus {
        outline: 2px solid #3273dc;
        outline-offset: 2px;
      }
    </style>
  </head>
