<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ordo Scheduler</title>

  <meta name="description" content="Run scheduled work across servers with explicit dependencies, calendars, and recovery paths when jobs fail, miss their window, or run too long." />

  <% my $base = $c->config->{public_url} // 'https://ordoscheduler.com'; %>
  <link rel="canonical" href="<%= $base %>/" />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />

  <meta name="msvalidate.01" content="5B10432B7C2937C0733DC84F0F158007" />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= $base %>/" />
  <meta property="og:title" content="Ordo - Job scheduling without the crontab chaos" />
  <meta property="og:description" content="Dependencies, calendars, and a defined path when something fails." />
  <meta property="og:image" content="<%= $base %>/img/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Ordo" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Ordo - Job scheduling without the crontab chaos" />
  <meta name="twitter:description" content="Dependencies, calendars, and a defined path when something fails." />
  <meta name="twitter:image" content="<%= $base %>/img/og-image.png" />

  <link rel="stylesheet" href="/css/app.css?v=<%= time %>" />
  <link rel="stylesheet" href="/css/job-templates.css?v=<%= time %>" />
  <% my $isSelfHosted = $c->is_selfhosted; %>

  <!-- Font Awesome -->
  <% if ($isSelfHosted) { %>
    <link rel="stylesheet" href="/lib/fontawesome/css/all.min.css" />
  <% } else { %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <% } %>

  <!-- Marked -->
  <% if ($isSelfHosted) { %>
    <script src="/lib/marked/marked.min.js"></script>
  <% } else { %>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <% } %>

  <!-- Highlight.js -->
  <% if ($isSelfHosted) { %>
    <script src="/lib/highlight/highlight.min.js"></script>
    <link rel="stylesheet" href="/lib/highlight/styles/atom-one-dark.min.css" />
  <% } else { %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css" />
  <% } %>

  <!-- Cytoscape + Dagre -->
  <% if ($isSelfHosted) { %>
    <script src="/lib/cytoscape/cytoscape.min.js"></script>
    <script src="/lib/cytoscape/dagre.min.js"></script>
    <script src="/lib/cytoscape/cytoscape-dagre.js"></script>
  <% } else { %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.28.1/cytoscape.min.js"></script>
    <script src="https://unpkg.com/dagre@0.8.5/dist/dagre.min.js"></script>
    <script src="https://unpkg.com/cytoscape-dagre@2.5.0/cytoscape-dagre.js"></script>
  <% } %>

  <!-- Tom Select -->
  <% if ($isSelfHosted) { %>
    <link href="/lib/tom-select/tom-select.css" rel="stylesheet" />
    <script src="/lib/tom-select/tom-select.complete.min.js"></script>
  <% } else { %>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
  <% } %>
</head>
<body>
  <!-- Main Flex Container -->
  <div class="app-wrapper">
    <!-- Navbar -->
    <%= include 'partials/navbar' %>
    <!-- Main Content Area -->
    <main class="main-content">
      <%= include 'partials/docs' %>
      <%= include 'partials/pricing' %>
      <%= include 'partials/servers' %>
      <%= include 'partials/jobs_clusters' %>
      <%= include 'partials/calendars' %>
      <%= include 'partials/dashboard' %>
      <%= include 'partials/settings' %>
    </main>
    <%= include 'partials/footer' %>
  </div>
  <%= include 'partials/modals' %>
  % use ordo::JobTemplates;
  <script>
    window.ORDO_JOB_TEMPLATES = <%== ordo::JobTemplates::json(app) %>;
  </script>
  % # Bust ES module graph: app.js?v= alone does not version relative imports (CF max-age=14400).
  % my $asset_v = time;
  % my $js_root = app->home->child('public/js');
  % my @js_mods = sort map { '/' . $_->to_rel(app->home->child('public')) }
  %   @{ $js_root->list_tree->grep(qr/\.js$/)->to_array };
  <script type="importmap">
  {
    "imports": {
% for my $i (0 .. $#js_mods) {
%   my $path = $js_mods[$i];
      "<%= $path %>": "<%= $path %>?v=<%= $asset_v %>"<%= $i < $#js_mods ? ',' : '' %>
% }
    }
  }
  </script>
  <script type="module" src="/js/app.js?v=<%= $asset_v %>"></script>
</body>
</html>
