      // Update org and team
      function updateOrgAndTeam(data) {
        orgData = data;
        renderOrgTeam();
        hideLoading("account-loading");
        document.getElementById("account-content").style.display = "block";
      }

      // Broadcast handlers
      function applyClusterBroadcast(data) {
        if (data.updates) {
          data.updates.forEach((update) => {
            let node = findClusterById(monitorData.tree, update.id);
            if (node) {
              Object.assign(node, update);
            } else {
              const newNode = {
                ...update,
                id: Number(update.id),
                type: "cluster",
                is_cluster: true,
                children: [],
                depth: 0,
              };
              if (update.parent_id != null) {
                const parent = findClusterById(
                  monitorData.tree,
                  update.parent_id,
                );
                if (parent) parent.children.push(newNode);
                else monitorData.tree.push(newNode);
              } else {
                monitorData.tree.push(newNode);
              }
            }
          });
        }
        if (data.deletes) {
          const uniqueDeletes = [
            ...new Set(data.deletes.map((d) => Number(d.id || d))),
          ];
          uniqueDeletes.forEach((id) =>
            removeClusterById(monitorData.tree, id),
          );
        }
        applyFilter();
        renderJobsTable();
      }

      function applyJobBroadcast(data) {
        if (data.updates) {
          data.updates.forEach((update) => {
            let node = findJobById(monitorData.tree, update.id);
            if (node) {
              Object.assign(node, update);
            } else {
              const newNode = {
                ...update,
                id: Number(update.id),
                type: "job",
                is_cluster: false,
                depth: 0,
              };
              if (update.cluster_id != null) {
                const parent = findClusterById(
                  monitorData.tree,
                  update.cluster_id,
                );
                if (parent) parent.children.push(newNode);
                else monitorData.tree.push(newNode);
              } else {
                monitorData.tree.push(newNode);
              }
            }
          });
        }
        if (data.deletes) {
          const uniqueDeletes = [
            ...new Set(data.deletes.map((d) => Number(d.id || d))),
          ];
          uniqueDeletes.forEach((id) => removeJobById(monitorData.tree, id));
        }
        applyFilter();
        renderJobsTable();
      }

      function applyCalBroadcast(data) {
        if (data.updates) {
          data.updates.forEach((update) => {
            const id = Number(update.id);
            const index = calendarsData.findIndex(
              (cal) => Number(cal.id) === id,
            );
            if (index !== -1) {
              calendarsData[index] = { ...calendarsData[index], ...update };
            } else {
              calendarsData.push({ ...update, id });
            }
          });
        }
        if (data.deletes) {
          const uniqueDeletes = [
            ...new Set(data.deletes.map((d) => Number(d.id || d))),
          ];
          uniqueDeletes.forEach((id) => {
            const index = calendarsData.findIndex(
              (cal) => Number(cal.id) === id,
            );
            if (index !== -1) calendarsData.splice(index, 1);
          });
        }
        renderCalendarsTable();
      }

      function applyServerBroadcast(data) {
        if (data.updates) {
          data.updates.forEach((update) => {
            const id = Number(update.id);
            const index = serversData.findIndex((s) => Number(s.id) === id);
            if (index !== -1) {
              serversData[index] = { ...serversData[index], ...update };
            } else {
              serversData.push({ ...update, id });
            }
          });
        }
        if (data.deletes) {
          const uniqueDeletes = [
            ...new Set(data.deletes.map((d) => Number(d.id || d))),
          ];
          uniqueDeletes.forEach((id) => {
            const index = serversData.findIndex((s) => Number(s.id) === id);
            if (index !== -1) serversData.splice(index, 1);
          });
        }
        renderServersTable();
      }

      // Find/Remove helpers
      function findClusterById(items, id) {
        id = Number(id);
        for (let item of items) {
          if (item.id === id && item.is_cluster) return item;
          if (item.children) {
            const found = findClusterById(item.children, id);
            if (found) return found;
          }
        }
        return null;
      }

      function findJobById(items, id) {
        id = Number(id);
        for (let item of items) {
          if (item.id === id && !item.is_cluster) return item;
          if (item.children) {
            const found = findJobById(item.children, id);
            if (found) return found;
          }
        }
        return null;
      }

      function removeClusterById(items, id) {
        id = Number(id);
        for (let i = 0; i < items.length; i++) {
          if (items[i].id === id && items[i].is_cluster) {
            items.splice(i, 1);
            return true;
          }
          if (items[i].children) {
            if (removeClusterById(items[i].children, id)) return true;
          }
        }
        return false;
      }

      function removeJobById(items, id) {
        id = Number(id);
        for (let i = 0; i < items.length; i++) {
          if (items[i].id === id && !items[i].is_cluster) {
            items.splice(i, 1);
            return true;
          }
          if (items[i].children) {
            if (removeJobById(items[i].children, id)) return true;
          }
        }
        return false;
      }

      // Jobs & Clusters
      function updateJobsClusters(data) {
        console.log("updateJobsClusters called, success:", data.success);
        hideLoading("monitor-loading");
        document.getElementById("monitor-content").style.display = "block";
        if (data.success) {
          console.log("Building tree...");
          monitorData.tree = buildTree(data);
          //console.log(JSON.stringify(monitorData.tree));

          console.log("Tree built, root children:", monitorData.tree.length);
          applyFilter();
          console.log(
            "Filter applied, visibleItems:",
            monitorData.visibleItems.length,
          );
          renderJobsTable();
          console.log("renderJobsTable called");
        } else {
          console.log("Data not success:", data);
        }
      }

      function buildTree(data) {
        console.log("buildTree called, clusters:", data.clusters?.length);
        const nodes = new Map();
        const root = { id: "root", children: [], depth: 0 };

        data.clusters.forEach((c) => {
          console.log(
            "Processing cluster:",
            c.id,
            c.name,
            "has jobs:",
            c.jobs?.length || 0,
          );
          const node = {
            ...c,
            id: Number(c.id),
            type: "cluster",
            is_cluster: true,
            children:
              c.jobs?.map((j) => {
                const job = {
                  ...j,
                  id: Number(j.id),
                  type: "job",
                  is_cluster: false,
                  depth: 0,
                };
                console.log("Added job:", job.id, job.name, "to cluster", c.id);
                return job;
              }) || [],
            depth: 0,
          };
          nodes.set(node.id, node);
        });

        data.clusters.forEach((c) => {
          const node = nodes.get(Number(c.id));
          if (c.parent_id == null) {
            root.children.push(node);
            node.depth = 0;
          } else {
            const parent = nodes.get(Number(c.parent_id));
            if (parent) {
              parent.children.push(node);
              node.depth = parent.depth + 1;
            } else {
              console.warn(
                "Orphan cluster:",
                node.id,
                "parent_id:",
                c.parent_id,
              );
              root.children.push(node);
              node.depth = 0;
            }
          }

          // Set depth for jobs
          node.children.forEach((job) => {
            job.depth = node.depth + 1;
          });
        });

        console.log("buildTree complete, root children:", root.children.length);
        console.log("Full tree:", JSON.stringify(root.children, null, 2));
        return root.children;
      }

      function applyFilter() {
        const filterLower = monitorData.filter.toLowerCase();
        const visible = [];
        //console.log("applyFilter started, Items:", monitorData.tree.length);
        //console.log("stringify:", JSON.stringify(monitorData.tree));

        const walk = (items, depth = 0) => {
          items.forEach((item) => {
            //console.log("Item:", item);
            const matches =
              !monitorData.filter ||
              item.name.toLowerCase().includes(filterLower) ||
              (item.server_name &&
                item.server_name.toLowerCase().includes(filterLower)) ||
              (item.jobstate &&
                item.jobstate.toLowerCase().includes(filterLower));

            // Always add the item if it's a cluster or a job
            visible.push({
              ...item,
              depth,
              last_start: formatTminus(item.started),
              duration: formatDuration(item.started, item.ended),
              next_start: formatTminus(item.next_start),
              needs: Object.keys(item.needs || {}),
            });

            if (item.is_cluster && item.children.length) {
              walk(item.children, depth + 1);
            }
          });
        };
        walk(monitorData.tree);
        monitorData.visibleItems = visible;
        console.log("applyFilter complete, visibleItems:", visible.length);
      }

function renderJobsTable() {
  const tbody = document.getElementById('tree-body');
  tbody.innerHTML = ''; // Clear previous rows

  function buildRows(items, depth = 0, parentId = null) {
    items.forEach(item => {
      const isCluster = item.is_cluster;
      const hasChildren = isCluster && item.children?.length > 0;

      const row = document.createElement('tr');
      row.className = isCluster ? 'ordo-cluster-row' : 'ordo-job-row';
      row.dataset.id = item.id;
      row.dataset.depth = depth;
      row.dataset.parent = parentId || '';
      row.dataset.hidden = 'false';
      row.style.setProperty('--depth', depth);

      // No pre-collapsed class — always fully expanded on render
      // (User can still collapse manually during the session)

      const toggleHtml = hasChildren
        ? `<span class="ordo-toggle"></span>`
        : '';

      const nameHtml = isCluster ? `${item.name}/` : item.name;

      row.innerHTML = `
        <td>
          ${toggleHtml}
          ${nameHtml}
        </td>
        <td>${item.id || '—'}</td>
        <td><span class="ordo-state ${stateClass(item.jobstate)}">${item.jobstate || '—'}</span></td>
        <td>${item.server_name || '—'}</td>
        <td>${item.pid || '—'}</td>
        <td>${formatTminus(item.started) || '—'}</td>
        <td>${formatDuration(item.started, item.ended) || '—'}</td>
        <td>${formatTminus(item.next_start) || '—'}</td>
        <td>${item.cal_name || '—'}</td>
        <td>${Object.keys(item.needs || {}).join(', ') || '—'}</td>
        <td>
          <div class="dropdown is-right is-up">
            <div class="dropdown-trigger">
              <button class="button is-small is-light" aria-haspopup="true" aria-controls="dropdown-menu">
                <i class="fas fa-ellipsis-v"></i>
              </button>
            </div>
            <div class="dropdown-menu" role="menu">
              <div class="dropdown-content">
                <a href="#" class="dropdown-item">Run</a>
                <a href="#" class="dropdown-item">Kill</a>
                <a href="#" class="dropdown-item">Hold</a>
                <hr class="dropdown-divider">
                <a href="#" class="dropdown-item is-danger">Delete</a>
              </div>
            </div>
          </div>
        </td>
      `;

      tbody.appendChild(row);

      if (hasChildren) {
        buildRows(item.children, depth + 1, item.id);
      }
    });
  }

  buildRows(monitorData.tree);
}

function toggleSubtree(parentId, hide) {
  const directChildren = document.querySelectorAll(`tr[data-parent="${parentId}"]`);
  directChildren.forEach(childRow => {
    childRow.dataset.hidden = hide ? 'true' : 'false';
    if (childRow.classList.contains('ordo-cluster-row')) {
      toggleSubtree(childRow.dataset.id, hide);
    }
  });
}
