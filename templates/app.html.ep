    <!-- Create/Edit Job or Cluster Modal -->
    <div id="entity-modal" class="modal">
      <div class="modal-background"></div>
      <div class="modal-card" style="width: 90%; max-width: 900px">
        <header class="modal-card-head">
          <p class="modal-card-title" id="entity-modal-title">New Job</p>
          <p
            class="ml-auto has-text-grey"
            id="entity-context"
            style="font-weight: normal"
          ></p>
          <button class="delete" aria-label="close"></button>
        </header>
        <section class="modal-card-body">
          <div class="field">
            <label class="label"
              >Name <span class="has-text-danger">*</span></label
            >
            <div class="control">
              <input
                class="input"
                type="text"
                id="entity-name"
                placeholder="e.g. db-backup"
              />
              <p class="help">
                Short name only — will be created in the selected cluster
              </p>
            </div>
          </div>

          <div class="field" id="entity-script-field">
            <label class="label"
              >Script / Command <span class="has-text-danger">*</span></label
            >
            <div class="control">
              <input
                class="input"
                type="text"
                id="entity-script"
                placeholder="ls -ltr"
              />
            </div>
          </div>

          <div class="field" id="entity-server-field">
            <label class="label"
              >Server <span class="has-text-danger">*</span></label
            >
            <div class="control">
              <div class="select is-fullwidth">
                <select id="entity-server"></select>
              </div>
            </div>
          </div>

          <div class="field">
            <label class="label">Description</label>
            <div class="control">
              <textarea
                class="textarea"
                id="entity-description"
                rows="2"
              ></textarea>
            </div>
          </div>

          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label">Calendar</label>
                <div class="control">
                  <div class="select is-fullwidth">
                    <select id="entity-calendar">
                      <option value="">None</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
            <div class="column" id="entity-tz-field">
              <div class="field">
                <label class="label">Timezone</label>
                <div class="control">
                  <input
                    class="input"
                    type="text"
                    id="entity-tz"
                    placeholder="UTC"
                  />
                </div>
              </div>
            </div>
          </div>

          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label">Needs (comma-separated names)</label>
                <div class="control">
                  <input
                    class="input"
                    type="text"
                    id="entity-needs"
                    placeholder="cleanup, send-report"
                  />
                </div>
              </div>
            </div>
            <div class="column">
              <div class="field">
                <label class="label">Needs Any</label>
                <div class="control">
                  <input
                    class="input"
                    type="text"
                    id="entity-needs-any"
                    placeholder="backup-a, backup-b"
                  />
                </div>
              </div>
            </div>
          </div>

          <div class="columns">
            <div class="column">
              <div class="field">
                <label class="label">On Fail (path)</label>
                <div class="control">
                  <input
                    class="input"
                    type="text"
                    id="entity-on-fail"
                    placeholder="alerts/send-email"
                  />
                </div>
              </div>
            </div>
            <div class="column">
              <div class="field">
                <label class="label">Loops</label>
                <div class="control">
                  <input
                    class="input"
                    type="number"
                    id="entity-loops"
                    min="0"
                    value="1"
                  />
                </div>
              </div>
            </div>
          </div>

          <div class="field" id="entity-retrys-field">
            <label class="label">Retries</label>
            <div class="control">
              <input
                class="input"
                type="number"
                id="entity-retrys"
                min="0"
                value="0"
              />
            </div>
          </div>

          <div class="field" id="entity-delay-field">
            <label class="label">Delay (seconds)</label>
            <div class="control">
              <input
                class="input"
                type="number"
                id="entity-delay"
                min="0"
                value="0"
              />
            </div>
          </div>
        </section>
        <footer class="modal-card-foot">
          <button class="button is-primary" id="save-entity">Save</button>
          <button class="button" id="cancel-entity">Cancel</button>
        </footer>
      </div>
    </div>

    <!-- Tab Switching -->
    <script>
      document.querySelectorAll(".tabs li").forEach((tab) => {
        tab.addEventListener("click", () => {
          document
            .querySelectorAll(".tabs li")
            .forEach((t) => t.classList.remove("is-active"));
          tab.classList.add("is-active");
          document.querySelectorAll(".tab-content").forEach((content) => {
            content.style.display =
              content.id === tab.dataset.target ? "block" : "none";
          });
        });
      });
    </script>

    <script>
      let ws = null;
      let monitorData = { tree: [] };
      let accountData = null;
      let orgData = null;
      let calendarsData = [];
      let serversData = [];
      let currentEditItem = null; // null or the full node object (job/cluster)
      let currentParentId = null; // for create: the clicked cluster's ID
      let currentParentName = null; // for display
      let currentAttachClusterId = null;

      const COLLAPSE_KEY = "ordo_collapsed_clusters";

      function getCollapsedIds() {
        try {
          const stored = localStorage.getItem(COLLAPSE_KEY);
          return stored ? new Set(JSON.parse(stored)) : new Set();
        } catch {
          return new Set();
        }
      }

      function saveCollapsedIds(set) {
        try {
          localStorage.setItem(COLLAPSE_KEY, JSON.stringify([...set]));
        } catch {}
      }

      document.addEventListener("DOMContentLoaded", () => {
        checkLoginAndConnect();
        const logoutLink = document.querySelector(
          '#private-end a[href="/logout"]',
        );
        if (logoutLink) {
          logoutLink.addEventListener("click", () =>
            localStorage.removeItem(COLLAPSE_KEY),
          );
        }
        document.querySelectorAll(".navbar-burger").forEach((burger) => {
          burger.addEventListener("click", () => {
            const target = document.getElementById(burger.dataset.target);
            burger.classList.toggle("is-active");
            target.classList.toggle("is-active");
          });
        });

        document.getElementById("tree-body").addEventListener("click", (e) => {
          // 1. Collapse toggle
          const toggle = e.target.closest(".ordo-toggle");
          if (toggle) {
            const row = toggle.closest("tr");
            const clusterId = row.dataset.id;
            const isCollapsed = row.classList.toggle("collapsed");
            const currentCollapsed = getCollapsedIds();
            if (isCollapsed) {
              currentCollapsed.add(clusterId);
            } else {
              currentCollapsed.delete(clusterId);
            }
            saveCollapsedIds(currentCollapsed);
            toggleSubtree(clusterId, isCollapsed);
            row.setAttribute("aria-expanded", (!isCollapsed).toString());
            if (!isCollapsed) {
              forceExpandDescendants(clusterId);
            }
            return;
          }

          // 2. Dropdown open/close + close others + flip
          const trigger = e.target.closest(".dropdown-trigger button");
          if (trigger) {
            e.stopPropagation();

            const dropdown = trigger.closest(".dropdown");

            // Close all OTHER open dropdowns
            document
              .querySelectorAll("#tree-body .dropdown.is-active")
              .forEach((other) => {
                if (other !== dropdown) {
                  other.classList.remove("is-active");
                }
              });

            // Toggle the clicked one
            const isOpening = !dropdown.classList.contains("is-active");
            dropdown.classList.toggle("is-active");

            if (isOpening) {
              const rect = trigger.getBoundingClientRect();
              const menu = dropdown.querySelector(".dropdown-menu");
              const menuWidth = menu.offsetWidth || 160;
              const spaceRight = window.innerWidth - rect.right;

              // Flip to left if not enough space on right
              if (spaceRight < menuWidth) {
                dropdown.classList.add("is-flipped");
              } else {
                dropdown.classList.remove("is-flipped");
              }
            }
            return;
          }

          // 3. Dropdown item clicks (actions)
          const item = e.target.closest(".dropdown-item");

          if (item) {
            const action = item.textContent.trim().toLowerCase();
            const row = item.closest("tr");
            const id = row.dataset.id;
            const name = row
              .querySelector("td:first-child")
              .textContent.trim()
              .replace(/[▶▼ ]/g, "")
              .trim();
            const isCluster = row.classList.contains("ordo-cluster-row");
            const type = isCluster ? "cluster" : "job";

            if (action === "attach calendar") {
              const row = item.closest("tr");
              const clusterId = Number(row.dataset.id);
              const clusterName = row
                .querySelector("td:first-child")
                .textContent.trim()
                .replace(/\/$/, "");
              const node = findClusterById(monitorData.tree, clusterId);
              openAttachCalendarModal(
                clusterId,
                clusterName,
                node.cal_name || "",
                node.cal_id || null,
              );
              return;
            }

            if (action === "edit") {
              const row = item.closest("tr");
              const id = Number(row.dataset.id);
              const isCluster = row.classList.contains("ordo-cluster-row");
              const node = isCluster
                ? findClusterById(monitorData.tree, id)
                : findJobById(monitorData.tree, id);
              if (node) {
                openEntityModal("edit", isCluster ? "cluster" : "job", node);
              }
              return;
            }

            if (action === "new cluster" || action === "new job") {
              const row = item.closest("tr");
              const parentId = Number(row.dataset.id);
              const parentName = row
                .querySelector("td:first-child")
                .textContent.trim()
                .replace(/[^\w\-\/].*/g, "")
                .replace(/\/$/, "");
              const type = action === "new job" ? "job" : "cluster";
              openEntityModal("create", type, null, parentId, parentName);
              return;
            }

            if (action === "view log" && isCluster) return;

            if (["kill", "delete"].includes(action)) {
              document.getElementById("confirm-message").textContent =
                `Are you sure you want to ${action} ${type} "${name}"?`;
              document
                .getElementById("confirm-modal")
                .classList.add("is-active");

              const yesBtn = document.getElementById("confirm-yes");
              const noBtn = document.getElementById("confirm-no");
              const closeBtn = document.getElementById("close-confirm");

              const handleConfirm = () => {
                sendCommand(action, id, type);
                document
                  .getElementById("confirm-modal")
                  .classList.remove("is-active");
                yesBtn.removeEventListener("click", handleConfirm);
              };

              yesBtn.addEventListener("click", handleConfirm);
              noBtn.addEventListener("click", () =>
                document
                  .getElementById("confirm-modal")
                  .classList.remove("is-active"),
              );
              closeBtn.addEventListener("click", () =>
                document
                  .getElementById("confirm-modal")
                  .classList.remove("is-active"),
              );
              return;
            }

            sendCommand(action, id, type);
            return;
          }
        });

        // Global outside click close
        document.addEventListener("click", (e) => {
          if (!e.target.closest(".dropdown")) {
            document
              .querySelectorAll(".dropdown.is-active")
              .forEach((d) => d.classList.remove("is-active"));
          }
        });

        // Close log modal
        document.getElementById("close-log").addEventListener("click", () => {
          document.getElementById("log-modal").classList.remove("is-active");
        });
        document
          .querySelector("#log-modal .modal-background")
          .addEventListener("click", () => {
            document.getElementById("log-modal").classList.remove("is-active");
          });

        // Refresh log (latest)
        document.getElementById("refresh-log").addEventListener("click", () => {
          const jobId = document.getElementById("log-modal").dataset.jobId;
          if (jobId) {
            ws.send(JSON.stringify({ command: "read_log", id: jobId }));
          }
        });

        // Open history modal and fetch logs
        document
          .getElementById("view-history")
          .addEventListener("click", () => {
            const jobId = document.getElementById("log-modal").dataset.jobId;
            if (jobId) {
              ws.send(JSON.stringify({ command: "find_log", id: jobId }));
              document
                .getElementById("log-history-modal")
                .classList.add("is-active");
            }
          });

        // Close history modal
        document
          .querySelector("#log-history-modal .delete")
          .addEventListener("click", () => {
            document
              .getElementById("log-history-modal")
              .classList.remove("is-active");
          });
        document
          .getElementById("close-log-history")
          .addEventListener("click", () => {
            document
              .getElementById("log-history-modal")
              .classList.remove("is-active");
          });
        document
          .querySelector("#log-history-modal .modal-background")
          .addEventListener("click", () => {
            document
              .getElementById("log-history-modal")
              .classList.remove("is-active");
          });

        // Confirmation modal close
        document
          .getElementById("close-confirm")
          .addEventListener("click", () => {
            document
              .getElementById("confirm-modal")
              .classList.remove("is-active");
          });
        document
          .querySelector("#confirm-modal .modal-background")
          .addEventListener("click", () => {
            document
              .getElementById("confirm-modal")
              .classList.remove("is-active");
          });
      });

      // Helper to send command
      function sendCommand(action, id, type) {
        let command;
        switch (action) {
          case "run":
            command = `start_${type}`;
            break;
          case "kill":
            command = `kill_${type}`;
            break;
          case "hold":
            command = `hold_${type}`;
            break;
          case "release":
            command = `release_${type}`;
            break;
          case "ice":
            command = `ice_${type}`;
            break;
          case "melt":
            command = `melt_${type}`;
            break;
          case "complete":
            command = `complete_${type}`;
            break; // both job and cluster
          case "reset":
            command = `reset_${type}`;
            break; // cluster only
          case "delete":
            command = `delete_${type}`;
            break;
          case "view log":
            ws.send(JSON.stringify({ command: "read_log", id: id }));
            document.getElementById("log-modal").classList.add("is-active");
            document.querySelector("#log-modal .modal-card-title").textContent =
              "Latest Job Log";
            document.getElementById("log-modal").dataset.jobId = id;
            return;
          default:
            return;
        }

        ws.send(JSON.stringify({ command, id }));
      }

      function checkLoginAndConnect() {
        const token = document.cookie.match(/ordo_token=([^;]+)/)?.[1];
        if (token) {
          document.getElementById("public-tabs").style.display = "none";
          document.getElementById("private-tabs").style.display = "flex";
          document.getElementById("public-end").style.display = "none";
          document.getElementById("private-end").style.display = "flex";
          document.querySelector('[data-target="account"]').click();
          connectWS(token);
        } else {
          document.getElementById("public-tabs").style.display = "flex";
          document.getElementById("private-tabs").style.display = "none";
          document.getElementById("public-end").style.display = "flex";
          document.getElementById("private-end").style.display = "none";
          document.querySelector('[data-target="about"]').click();
        }
      }

      function connectWS(token) {
        const proto = location.protocol === "https:" ? "wss:" : "ws:";
        ws = new WebSocket(`${proto}//${location.host}/websocket`);
        ws.addEventListener("open", () => {
          console.log("WS connected");
          ws.send(JSON.stringify({ command: "login_user", token }));
        });
        ws.onmessage = (e) => {
          console.log("WS message:", e.data);
          try {
            const data = JSON.parse(e.data);
            if (data.command_reply === "login_user" && data.success) {
              console.log("Login success - requesting initial loads");
              ws.send(JSON.stringify({ command: "read_user" }));
              ws.send(JSON.stringify({ command: "read_org" }));
              ws.send(
                JSON.stringify({ command: "find_cluster", name: "/root" }),
              );
              ws.send(JSON.stringify({ command: "find_cal" }));
              ws.send(JSON.stringify({ command: "find_monitor" }));
            }
            if (data.command_reply === "read_user") updateAccount(data);
            if (data.command_reply === "read_org") updateOrgAndTeam(data);
            if (data.command_reply === "read_log") updateLog(data);
            if (data.command_reply === "find_log") {
              updateLogHistory(data);
            }
            if (data.command_reply === "find_cluster") updateJobsClusters(data);
            if (data.command_reply === "find_cal") updateCalendars(data);
            if (data.command_reply === "find_monitor") updateServers(data);
            if (data.broadcast === "clusters_changed")
              applyClusterBroadcast(data);
            if (data.broadcast === "jobs_changed") applyJobBroadcast(data);
            if (data.broadcast === "cals_changed") applyCalBroadcast(data);
            if (data.broadcast === "servers_changed")
              applyServerBroadcast(data);
            if (data.broadcast === "org_changed") updateOrgAndTeam(data);
            if (data.command_reply && data.message) {
              showToast(data.message, data.success ? "success" : "danger");
            }
          } catch (err) {
            console.error("Parse error:", err);
          }
        };
        ws.onclose = () => {
          console.log("WS closed");
          setTimeout(checkLoginAndConnect, 5000);
        };
      }

      // populate create/edit dropdown
      function populateServerSelect() {
        const select = document.getElementById("entity-server");
        select.innerHTML = "";
        serversData.forEach((server) => {
          const opt = document.createElement("option");
          opt.value = server.name;
          opt.textContent = server.name;
          select.appendChild(opt);
        });
      }

      function populateCalendarSelect() {
        const select = document.getElementById("entity-calendar");
        const current = select.value;
        select.innerHTML = '<option value="">None</option>';
        calendarsData.forEach((cal) => {
          const opt = document.createElement("option");
          opt.value = cal.id;
          opt.textContent = cal.name;
          select.appendChild(opt);
        });
        select.value = current;
      }

      // main modal logic
      function openEntityModal(
        mode = "create",
        type = "job",
        item = null,
        parentId = null,
        parentName = null,
      ) {
        currentEditItem = item;
        currentParentId = parentId;
        currentParentName = parentName;

        const isEdit = mode === "edit";
        const isJob = type === "job";
        const isCluster = type === "cluster";

        document.getElementById("entity-modal-title").textContent = isEdit
          ? `Edit ${isJob ? "Job" : "Cluster"}`
          : `New ${isJob ? "Job" : "Cluster"}`;

        // Context line
        const contextEl = document.getElementById("entity-context");
        if (isEdit) {
          contextEl.textContent = `ID: ${item.id}`;
        } else if (parentName) {
          contextEl.textContent = `In cluster: ${parentName} (ID: ${parentId})`;
        } else {
          contextEl.textContent = "In root";
        }

        // Show/hide fields
        document.getElementById("entity-script-field").style.display = isJob
          ? "block"
          : "none";
        document.getElementById("entity-server-field").style.display = isJob
          ? "block"
          : "none";
        document.getElementById("entity-tz-field").style.display = isCluster
          ? "block"
          : "none";
        document.getElementById("entity-retrys-field").style.display = isJob
          ? "block"
          : "none";
        document.getElementById("entity-delay-field").style.display = isJob
          ? "block"
          : "none";

        // Populate values
        if (isEdit && item) {
          document.getElementById("entity-name").value = item.name || "";
          document.getElementById("entity-description").value =
            item.description || "";
          document.getElementById("entity-script").value = item.script || "";
          document.getElementById("entity-server").value =
            item.server_name || "";
          document.getElementById("entity-calendar").value = item.cal_id || "";
          document.getElementById("entity-tz").value = item.tz || "";
          document.getElementById("entity-needs").value = Object.keys(
            item.needs || {},
          ).join(", ");
          document.getElementById("entity-needs-any").value =
            item.needs_any || "";
          document.getElementById("entity-on-fail").value = item.on_fail || "";
          document.getElementById("entity-loops").value = item.loops || 1;
          document.getElementById("entity-retrys").value = item.retrys || 0;
          document.getElementById("entity-delay").value = item.delay || 0;
        } else {
          document.getElementById("entity-name").value = isJob
            ? "new-job"
            : "new-cluster";
          document.getElementById("entity-description").value = "";
          document.getElementById("entity-script").value = "";
          document.getElementById("entity-server").value =
            serversData[0]?.name || "";
          document.getElementById("entity-calendar").value = "";
          document.getElementById("entity-tz").value = "UTC";
          document.getElementById("entity-needs").value = "";
          document.getElementById("entity-needs-any").value = "";
          document.getElementById("entity-on-fail").value = "";
          document.getElementById("entity-loops").value = "1";
          document.getElementById("entity-retrys").value = "0";
          document.getElementById("entity-delay").value = "0";
        }

        populateServerSelect();
        populateCalendarSelect();

        document.getElementById("entity-modal").classList.add("is-active");
      }

      // Close handlers
      document
        .querySelector("#entity-modal .delete")
        .addEventListener("click", () => {
          document.getElementById("entity-modal").classList.remove("is-active");
        });
      document.getElementById("cancel-entity").addEventListener("click", () => {
        document.getElementById("entity-modal").classList.remove("is-active");
      });
      document
        .querySelector("#entity-modal .modal-background")
        .addEventListener("click", () => {
          document.getElementById("entity-modal").classList.remove("is-active");
        });

      // Save
      document.getElementById("save-entity").addEventListener("click", () => {
        const name = document.getElementById("entity-name").value.trim();
        if (!name) {
          showToast("Name is required", "danger");
          return;
        }

        const isEdit = currentEditItem !== null;
        const isJob = !currentEditItem
          ? document.getElementById("entity-script-field").style.display !==
            "none"
          : !currentEditItem.is_cluster;

        const payload = {
          command: isEdit
            ? isJob
              ? "update_job"
              : "update_cluster"
            : isJob
              ? "create_job"
              : "create_cluster",
          name,
        };

        if (isEdit) {
          payload.id = currentEditItem.id;
        } else {
          payload.parent_id = currentParentId;
        }

        if (isJob) {
          const script = document.getElementById("entity-script").value.trim();
          const server = document.getElementById("entity-server").value;
          if (!script || !server) {
            showToast("Script and Server are required for jobs", "danger");
            return;
          }
          payload.script = script;
          payload.server = server;
          const retrys = document.getElementById("entity-retrys").value;
          if (retrys) payload.retrys = Number(retrys);
          const delay = document.getElementById("entity-delay").value;
          if (delay) payload.delay = Number(delay);
        } else {
          const tz = document.getElementById("entity-tz").value.trim();
          if (tz) payload.tz = tz;
        }

        const description = document
          .getElementById("entity-description")
          .value.trim();
        if (description) payload.description = description;

        const calId = document.getElementById("entity-calendar").value;
        if (calId) payload.cal_id = Number(calId);

        const needs = document.getElementById("entity-needs").value.trim();
        if (needs) payload.needs = needs;

        const needsAny = document
          .getElementById("entity-needs-any")
          .value.trim();
        if (needsAny) payload.needs_any = needsAny;

        const onFail = document.getElementById("entity-on-fail").value.trim();
        if (onFail) payload.on_fail = onFail;

        const loops = document.getElementById("entity-loops").value;
        if (loops && loops !== "1") payload.loops = Number(loops);

        ws.send(JSON.stringify(payload));
        showToast(isEdit ? "Update sent" : "Creation requested", "info");
        document.getElementById("entity-modal").classList.remove("is-active");
      });

      function openAttachCalendarModal(
        clusterId,
        clusterName,
        currentCalName = "",
        currentCalId = null,
      ) {
        currentAttachClusterId = clusterId;

        document.getElementById("attach-target-name").textContent = clusterName;

        const select = document.getElementById("attach-cal-select");
        select.innerHTML = '<option value="">None (run manually only)</option>';

        if (calendarsData.length === 0) {
          select.innerHTML +=
            "<option disabled>(No calendars defined)</option>";
        } else {
          calendarsData.forEach((cal) => {
            const opt = document.createElement("option");
            opt.value = cal.id;
            opt.textContent = cal.name;
            if (Number(cal.id) === Number(currentCalId)) {
              opt.selected = true;
            }
            select.appendChild(opt);
          });
        }

        document.getElementById("attach-current-cal").textContent =
          currentCalName || "None";

        document.getElementById("attach-cal-modal").classList.add("is-active");
      }

      // Shared utilities
      function showToast(message, type = "info") {
        const toast = document.createElement("div");
        toast.className = `notification is-${type}`;
        toast.innerHTML = `<button class="delete"></button><span>${message}</span>`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 5000);
      }

      function showLoading(containerId) {
        const loading = document.getElementById(containerId);
        if (loading) loading.style.display = "block";
      }
      function hideLoading(containerId) {
        const loading = document.getElementById(containerId);
        if (loading) loading.style.display = "none";
      }
      function formatDate(epoch) {
        if (!epoch) return "—";
        return new Date(epoch * 1000).toLocaleString();
      }
      function formatTplus(epoch) {
        if (!epoch || isNaN(epoch)) return "—";
        const diff = Math.floor(Date.now() / 1000) - epoch;
        if (diff <= 0) return "T+0";
        const h = Math.floor(diff / 3600)
          .toString()
          .padStart(2, "0");
        const m = Math.floor((diff % 3600) / 60)
          .toString()
          .padStart(2, "0");
        const s = (diff % 60).toString().padStart(2, "0");
        return `T+${h}:${m}:${s}`;
      }
      function formatTminus(epoch) {
        if (!epoch || isNaN(epoch)) return "—";
        const diff = epoch - Math.floor(Date.now() / 1000);
        if (diff <= 0) return "Overdue";
        const h = Math.floor(diff / 3600)
          .toString()
          .padStart(2, "0");
        const m = Math.floor((diff % 3600) / 60)
          .toString()
          .padStart(2, "0");
        const s = (diff % 60).toString().padStart(2, "0");
        return `T-${h}:${m}:${s}`;
      }
      function formatDuration(start, end) {
        if (!start) return "—";
        const endTime = end || Math.floor(Date.now() / 1000);
        const diff = endTime - start;
        if (diff <= 0) return "—";
        const h = Math.floor(diff / 3600)
          .toString()
          .padStart(2, "0");
        const m = Math.floor((diff % 3600) / 60)
          .toString()
          .padStart(2, "0");
        const s = (diff % 60).toString().padStart(2, "0");
        return `${h}:${m}:${s}`;
      }

      function stateClass(state) {
        if (!state) return "ordo-default";
        const lowerState = state.toLowerCase();
        if (["complete"].includes(lowerState)) return "ordo-complete";
        if (["immutable", "ice", "pruned"].includes(lowerState))
          return "ordo-immutable";
        if (lowerState === "running") return "ordo-running";
        if (["failed", "hold", "zombie", "killed"].includes(lowerState))
          return "ordo-failed";
        if (["ready", "waiting", "looping", "retrying"].includes(lowerState))
          return "ordo-ready";
        return "ordo-default";
      }

      // Render user profile
      function renderUserProfile() {
        if (!accountData || !accountData.success) return;
        document.getElementById("account-email").textContent =
          accountData.email || "—";
        document.getElementById("account-id").textContent =
          accountData.id || "—";
        document.getElementById("account-level").textContent =
          accountData.level || "—";
        document.getElementById("edit-name").value = accountData.name || "";
        document.getElementById("edit-mode").value = accountData.mode || "";
        document.getElementById("account-creation").textContent =
          formatDate(accountData.creation_time) || "—";
        document.getElementById("account-update").textContent =
          formatDate(accountData.update_time) || "—";
        document.getElementById("account-remote").textContent =
          accountData.remote_address || "—";
        document.getElementById("account-token").value =
          accountData.token || "—";
      }

      // Update account
      function updateAccount(data) {
        accountData = data;
        hideLoading("account-loading");
        document.getElementById("account-content").style.display = "block";
        renderUserProfile();
      }

      // Render org and team
      function renderOrgTeam() {
        if (!orgData) return;
        document.getElementById("org-id").textContent = orgData.id || "—";
        document.getElementById("edit-org-name").value = orgData.name || "";
        document.getElementById("edit-org-desc").value =
          orgData.description || "";
        document.getElementById("org-creation").textContent =
          formatDate(orgData.creation_time) || "—";
        const teamBody = document.getElementById("team-body");
        teamBody.innerHTML = "";
        if (orgData.members?.length) {
          orgData.members.forEach((member) => {
            const row = document.createElement("tr");
            row.innerHTML = `
              <td>${member.email || "—"}</td>
              <td>${member.id || "—"}</td>
              <td>${member.level || "—"}</td>
              <td>${formatDate(member.creation_time) || "—"}</td>
            `;
            teamBody.appendChild(row);
          });
          document.getElementById("no-team").style.display = "none";
        } else {
          document.getElementById("no-team").style.display = "block";
        }
      }

      function updateLog(data) {
        document.getElementById("log-content").textContent = data.out;
      }

      function updateLogHistory(data) {
        const tbody = document.getElementById("log-history-body");
        const noHistory = document.getElementById("no-history");
        tbody.innerHTML = "";

        if (!data.logs || data.logs.length === 0) {
          noHistory.style.display = "block";
          return;
        }

        noHistory.style.display = "none";

        data.logs.forEach((log) => {
          const row = document.createElement("tr");
          row.style.cursor = "pointer";
          row.innerHTML = `
      <td>${log.id}</td>
      <td>${formatDate(log.started) || "—"}</td>
      <td>${formatDuration(log.started, log.ended) || "—"}</td>
      <td>${log.exit_code === 0 ? "Success" : (log.exit_code ?? "—")}</td>
    `;

          row.addEventListener("click", () => {
            const jobId = document.getElementById("log-modal").dataset.jobId;
            ws.send(
              JSON.stringify({
                command: "read_log",
                id: jobId,
                log_id: log.id,
              }),
            );
            document
              .getElementById("log-history-modal")
              .classList.remove("is-active");
            document.querySelector("#log-modal .modal-card-title").textContent =
              `Job Log - Run #${log.id}`;
          });

          tbody.appendChild(row);
        });
      }

      // Update org and team
      function updateOrgAndTeam(data) {
        orgData = data;
        renderOrgTeam();
        hideLoading("account-loading");
        document.getElementById("account-content").style.display = "block";
      }

      // Broadcast handlers
      function applyClusterBroadcast(data) {
        if (data.updates) {
          data.updates.forEach((update) => {
            let node = findClusterById(monitorData.tree, update.id);
            if (node) {
              Object.assign(node, update);
            } else {
              const newNode = {
                ...update,
                id: Number(update.id),
                type: "cluster",
                is_cluster: true,
                children: [],
                depth: 0,
              };
              if (update.parent_id != null) {
                const parent = findClusterById(
                  monitorData.tree,
                  update.parent_id,
                );
                if (parent) parent.children.push(newNode);
                else monitorData.tree.push(newNode);
              } else {
                monitorData.tree.push(newNode);
              }
            }
          });
        }
        if (data.deletes) {
          const uniqueDeletes = [
            ...new Set(data.deletes.map((d) => Number(d.id || d))),
          ];
          uniqueDeletes.forEach((id) =>
            removeClusterById(monitorData.tree, id),
          );
        }
        renderJobsTable();
      }

      function applyJobBroadcast(data) {
        if (data.updates) {
          data.updates.forEach((update) => {
            let node = findJobById(monitorData.tree, update.id);
            if (node) {
              Object.assign(node, update);
            } else {
              const newNode = {
                ...update,
                id: Number(update.id),
                type: "job",
                is_cluster: false,
                depth: 0,
              };
              if (update.cluster_id != null) {
                const parent = findClusterById(
                  monitorData.tree,
                  update.cluster_id,
                );
                if (parent) parent.children.push(newNode);
                else monitorData.tree.push(newNode);
              } else {
                monitorData.tree.push(newNode);
              }
            }
          });
        }
        if (data.deletes) {
          const uniqueDeletes = [
            ...new Set(data.deletes.map((d) => Number(d.id || d))),
          ];
          uniqueDeletes.forEach((id) => removeJobById(monitorData.tree, id));
        }
        renderJobsTable();
      }

      function applyCalBroadcast(data) {
        if (data.updates) {
          data.updates.forEach((update) => {
            const id = Number(update.id);
            const index = calendarsData.findIndex(
              (cal) => Number(cal.id) === id,
            );
            if (index !== -1) {
              calendarsData[index] = { ...calendarsData[index], ...update };
            } else {
              calendarsData.push({ ...update, id });
            }
          });
        }
        if (data.deletes) {
          const uniqueDeletes = [
            ...new Set(data.deletes.map((d) => Number(d.id || d))),
          ];
          uniqueDeletes.forEach((id) => {
            const index = calendarsData.findIndex(
              (cal) => Number(cal.id) === id,
            );
            if (index !== -1) calendarsData.splice(index, 1);
          });
        }
        renderCalendarsTable();
      }

      function applyServerBroadcast(data) {
        if (data.updates) {
          data.updates.forEach((update) => {
            const id = Number(update.id);
            const index = serversData.findIndex((s) => Number(s.id) === id);
            if (index !== -1) {
              serversData[index] = { ...serversData[index], ...update };
            } else {
              serversData.push({ ...update, id });
            }
          });
        }
        if (data.deletes) {
          const uniqueDeletes = [
            ...new Set(data.deletes.map((d) => Number(d.id || d))),
          ];
          uniqueDeletes.forEach((id) => {
            const index = serversData.findIndex((s) => Number(s.id) === id);
            if (index !== -1) serversData.splice(index, 1);
          });
        }
        renderServersTable();
      }

      // Find helpers
      function findClusterById(items, id) {
        id = Number(id);
        for (let item of items) {
          if (item.id === id && item.is_cluster) return item;
          if (item.children) {
            const found = findClusterById(item.children, id);
            if (found) return found;
          }
        }
        return null;
      }

      function findJobById(items, id) {
        id = Number(id);
        for (let item of items) {
          if (item.id === id && !item.is_cluster) return item;
          if (item.children) {
            const found = findJobById(item.children, id);
            if (found) return found;
          }
        }
        return null;
      }

      function removeClusterById(items, id) {
        id = Number(id);
        for (let i = 0; i < items.length; i++) {
          if (items[i].id === id && items[i].is_cluster) {
            items.splice(i, 1);
            return true;
          }
          if (items[i].children) {
            if (removeClusterById(items[i].children, id)) return true;
          }
        }
        return false;
      }

      function removeJobById(items, id) {
        id = Number(id);
        for (let i = 0; i < items.length; i++) {
          if (items[i].id === id && !items[i].is_cluster) {
            items.splice(i, 1);
            return true;
          }
          if (items[i].children) {
            if (removeJobById(items[i].children, id)) return true;
          }
        }
        return false;
      }

      // Jobs & Clusters
      function updateJobsClusters(data) {
        hideLoading("monitor-loading");
        document.getElementById("monitor-content").style.display = "block";
        if (data.success) {
          monitorData.tree = buildTree(data);
          renderJobsTable();
        }
      }

      function buildTree(data) {
        const nodes = new Map();
        const root = { id: "root", children: [], depth: 0 };
        data.clusters.forEach((c) => {
          const node = {
            ...c,
            id: Number(c.id),
            type: "cluster",
            is_cluster: true,
            children:
              c.jobs?.map((j) => ({
                ...j,
                id: Number(j.id),
                type: "job",
                is_cluster: false,
                depth: 0,
              })) || [],
            depth: 0,
          };
          nodes.set(node.id, node);
        });
        data.clusters.forEach((c) => {
          const node = nodes.get(Number(c.id));
          if (c.parent_id == null) {
            root.children.push(node);
            node.depth = 0;
          } else {
            const parent = nodes.get(Number(c.parent_id));
            if (parent) {
              parent.children.push(node);
              node.depth = parent.depth + 1;
            } else {
              root.children.push(node);
              node.depth = 0;
            }
          }
          node.children.forEach((job) => (job.depth = node.depth + 1));
        });
        return root.children;
      }

      // Calendars
      function updateCalendars(data) {
        hideLoading("calendars-loading");
        document.getElementById("calendars-content").style.display = "block";
        if (data.success) {
          calendarsData = data.cals || [];
          renderCalendarsTable();
        }
      }

      function renderCalendarsTable() {
        const tbody = document.getElementById("calendars-body");
        tbody.innerHTML = "";
        calendarsData.forEach((cal) => {
          const row = document.createElement("tr");
          row.innerHTML = `
                    <td>${cal.name || "—"}</td>
                    <td>${cal.type || "—"}</td>
                    <td>${cal.cron || "—"}</td>
                    <td><span class="tag is-light">${cal.state || "—"}</span></td>
                    <td>
                      <div class="dropdown">
                        <div class="dropdown-trigger">
                          <button class="button is-small is-light" aria-haspopup="true" aria-controls="dropdown-menu">
                            <i class="fas fa-ellipsis-v"></i>
                          </button>
                        </div>
                        <div class="dropdown-menu" role="menu">
                          <div class="dropdown-content">
                            <a href="#" class="dropdown-item">Edit</a>
                            <hr class="dropdown-divider">
                            <a href="#" class="dropdown-item is-danger">Delete</a>
                          </div>
                        </div>
                      </div>
                    </td>
                  `;
          tbody.appendChild(row);
        });
      }

      // Servers
      function updateServers(data) {
        hideLoading("servers-loading");
        document.getElementById("servers-content").style.display = "block";
        if (data.success) {
          serversData = data.servers || [];
          renderServersTable();
        }
      }

      function renderServersTable() {
        const tbody = document.getElementById("servers-body");
        tbody.innerHTML = "";
        serversData.forEach((server) => {
          const row = document.createElement("tr");
          row.innerHTML = `
                    <td>${server.name || "—"}</td>
                    <td><span class="tag ${server.status === "online" ? "is-success" : "is-danger"}">${server.status || "—"}</span></td>
                    <td>${server.load || "—"}</td>
                    <td>
                      <div class="dropdown">
                        <div class="dropdown-trigger">
                          <button class="button is-small is-light" aria-haspopup="true" aria-controls="dropdown-menu">
                            <i class="fas fa-ellipsis-v"></i>
                          </button>
                        </div>
                        <div class="dropdown-menu" role="menu">
                          <div class="dropdown-content">
                            <a href="#" class="dropdown-item">Edit</a>
                            <hr class="dropdown-divider">
                            <a href="#" class="dropdown-item is-danger">Delete</a>
                          </div>
                        </div>
                      </div>
                    </td>
                  `;
          tbody.appendChild(row);
        });
      }

      function renderJobsTable() {
        const tbody = document.getElementById("tree-body");
        tbody.innerHTML = "";
        buildRows(monitorData.tree);

        // Hide subtrees for collapsed clusters
        document
          .querySelectorAll(".ordo-cluster-row.collapsed")
          .forEach((row) => {
            toggleSubtree(row.dataset.id, true);
          });
      }

      function buildRows(items, depth = 0, parentId = null) {
        const collapsedSet = getCollapsedIds(); // fresh read from localStorage

        items.forEach((item) => {
          const isCluster = item.is_cluster;
          const hasChildren = isCluster && item.children?.length > 0;
          const state = item.jobstate?.toLowerCase() || "";

          // Context-sensitive enabling (more permissive)

          // Context-sensitive enabling (allow hold/ice on complete/ready/waiting/etc.)
          const runDisabled =
            state === "running" ||
            state === "immutable" ||
            state === "ice" ||
            state === "hold"
              ? "disabled"
              : "";
          const killDisabled = state === "running" ? "" : "disabled";
          const holdDisabled =
            state === "hold" || state === "immutable" || state === "ice"
              ? "disabled"
              : ""; // allow on complete/ready/waiting
          const releaseDisabled = state === "hold" ? "" : "disabled";
          const iceDisabled =
            state === "ice" || state === "immutable" ? "disabled" : ""; // allow on complete/ready/waiting
          const meltDisabled = state === "ice" ? "" : "disabled";
          const completeDisabled = ""; // always enabled
          const resetDisabled = isCluster ? "" : "disabled";
          const viewLogDisabled = isCluster ? "disabled" : "";
          const isRoot = item.name === "root" && item.parent_id == null;
          const newJobDisabled = isCluster && !isRoot ? "" : "disabled";
          const newClusterDisabled = isCluster ? "" : "disabled";

          const row = document.createElement("tr");
          row.className = isCluster ? "ordo-cluster-row" : "ordo-job-row";
          row.dataset.id = item.id;
          row.dataset.depth = depth;
          row.dataset.parent = parentId || "";
          row.dataset.hidden = "false";
          row.style.setProperty("--depth", depth);

          // ARIA attributes
          row.setAttribute("role", "row");
          row.setAttribute("aria-level", (depth + 1).toString());
          if (isCluster) {
            const isCollapsed = collapsedSet.has(String(item.id));
            if (isCollapsed) row.classList.add("collapsed");
            row.setAttribute("aria-expanded", (!isCollapsed).toString());
          }

          // Toggle arrow (chevron icons)
          const toggleHtml = hasChildren
            ? `<span class="ordo-toggle"></span>`
            : "";

          // Icon + name
          const icon = isCluster
            ? '<i class="fas fa-folder mr-2 has-text-info"></i>'
            : '<i class="fas fa-cog mr-2 has-text-grey"></i>';
          const nameHtml = `${icon}${isCluster ? item.name + "/" : item.name}`;

          row.innerHTML = `
  <td>
    ${toggleHtml}
    ${nameHtml}
  </td>
  <td>${item.id || "—"}</td>
  <td><span class="ordo-state ${stateClass(item.jobstate)}">${item.jobstate || "—"}</span></td>
  <td>${item.server_name || "—"}</td>
  <td>${item.pid || "—"}</td>
  <td>${formatTplus(item.started) || "—"}</td>
  <td>${formatDuration(item.started, item.ended) || "—"}</td>
  <td>${formatTminus(item.next_start) || "—"}</td>
  <td>${item.cal_name || "—"}</td>
  <td>${Object.keys(item.needs || {}).join(", ") || "—"}</td>
  <td>
    <div class="dropdown">
      <div class="dropdown-trigger">
        <button class="button is-small is-light" aria-haspopup="true" aria-controls="dropdown-menu">
          <i class="fas fa-ellipsis-v"></i>
        </button>
      </div>
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-content">
          <a href="#" class="dropdown-item">Edit</a>
          <hr class="dropdown-divider">
          ${
            isCluster
              ? `
            <a href="#" class="dropdown-item ${newClusterDisabled}">New Cluster</a>
            <a href="#" class="dropdown-item ${newJobDisabled}">New Job</a>
            <a href="#" class="dropdown-item">Attach Calendar</a>
            <hr class="dropdown-divider">
          `
              : ""
          }
          <a href="#" class="dropdown-item ${runDisabled}">Run</a>
          <a href="#" class="dropdown-item ${killDisabled}">Kill</a>
          <a href="#" class="dropdown-item ${holdDisabled}">Hold</a>
          <a href="#" class="dropdown-item ${releaseDisabled}">Release</a>
          <a href="#" class="dropdown-item ${iceDisabled}">Ice</a>
          <a href="#" class="dropdown-item ${meltDisabled}">Melt</a>
          <a href="#" class="dropdown-item ${completeDisabled}">Complete</a>
          ${
            isCluster
              ? `<hr class="dropdown-divider">
          <a href="#" class="dropdown-item ${resetDisabled}">Reset</a>`
              : ""
          }
          <hr class="dropdown-divider">
          <a href="#" class="dropdown-item is-danger">Delete</a>
          <hr class="dropdown-divider">
          <a href="#" class="dropdown-item ${viewLogDisabled}">View Log</a>
        </div>
      </div>
    </div>
  </td>
`;

          document.getElementById("tree-body").appendChild(row);

          if (hasChildren) {
            buildRows(item.children, depth + 1, item.id);
          }
        });
      }

      function toggleSubtree(parentId, hide) {
        const directChildren = document.querySelectorAll(
          `tr[data-parent="${parentId}"]`,
        );
        directChildren.forEach((childRow) => {
          childRow.dataset.hidden = hide ? "true" : "false";
          if (childRow.classList.contains("ordo-cluster-row")) {
            toggleSubtree(childRow.dataset.id, hide);
          }
        });
      }

      function forceExpandDescendants(startId) {
        const children = document.querySelectorAll(
          `tr[data-parent="${startId}"]`,
        );
        children.forEach((childRow) => {
          if (childRow.classList.contains("ordo-cluster-row")) {
            childRow.classList.remove("collapsed");
            forceExpandDescendants(childRow.dataset.id);
          }
        });
      }

      // Docs loading
      function loadDoc(file) {
        fetch(`/docs/${file}`)
          .then((response) => {
            if (!response.ok) throw new Error(`Failed to load ${file}`);
            return response.text();
          })
          .then((md) => {
            const html = marked.parse(md);
            document.getElementById("docs-content").innerHTML = html;

            // Highlight code blocks — safe even if hljs not loaded yet
            if (typeof hljs !== "undefined") {
              hljs.highlightAll();
            } else {
              // Wait for hljs to load
              const checkHljs = setInterval(() => {
                if (typeof hljs !== "undefined") {
                  clearInterval(checkHljs);
                  hljs.highlightAll();
                }
              }, 100);
            }

            // Update active TOC link
            document
              .querySelectorAll("#docs-toc a")
              .forEach((a) => a.classList.remove("is-active"));
            const activeLink = document.querySelector(
              `#docs-toc a[data-file="${file}"]`,
            );
            if (activeLink) activeLink.classList.add("is-active");
          })
          .catch((err) => {
            document.getElementById("docs-content").innerHTML =
              `<p class="has-text-danger has-text-centered">Error loading documentation: ${err.message}</p>`;
          });
      }

      // listeners
      document
        .querySelector("#attach-cal-modal .delete")
        .addEventListener("click", () => {
          document
            .getElementById("attach-cal-modal")
            .classList.remove("is-active");
        });
      document
        .getElementById("cancel-attach-cal")
        .addEventListener("click", () => {
          document
            .getElementById("attach-cal-modal")
            .classList.remove("is-active");
        });
      document
        .querySelector("#attach-cal-modal .modal-background")
        .addEventListener("click", () => {
          document
            .getElementById("attach-cal-modal")
            .classList.remove("is-active");
        });

      document
        .getElementById("save-attach-cal")
        .addEventListener("click", () => {
          const calId = document.getElementById("attach-cal-select").value;

          const payload = {
            command: "update_cluster",
            id: currentAttachClusterId,
          };

          if (calId) {
            payload.cal_id = Number(calId);
          } // else: omit → detaches

          console.log("attachcal:", payload);

           

          ws.send(JSON.stringify(payload));
          showToast("Calendar updated", "info");

          document
            .getElementById("attach-cal-modal")
            .classList.remove("is-active");
        });

// Mobile TOC toggle
document.getElementById('docs-toc-toggle')?.addEventListener('click', () => {
  document.getElementById('docs-toc').classList.toggle('is-open');
});

      // TOC click handler
      document.getElementById("docs-toc")?.addEventListener("click", (e) => {
        const link = e.target.closest("a");
        if (link && link.dataset.file) {
          e.preventDefault();
          loadDoc(link.dataset.file);
        }
      });

      // Load Quickstart by default when Docs tab is opened
      document
        .querySelector('[data-target="docs"]')
        ?.addEventListener("click", () => {
          if (document.getElementById("docs-content").innerHTML === "") {
            loadDoc("quickstart.md");
          }
        });

      // Live updater (simple selectors)
      setInterval(() => {
        document.getElementById("current-time").textContent =
          new Date().toLocaleString();

        document.querySelectorAll("tr[data-id]").forEach((row) => {
          const id = row.dataset.id;
          let item = null;

          if (row.classList.contains("ordo-cluster-row")) {
            item = findClusterById(monitorData.tree, id);
          } else {
            item = findJobById(monitorData.tree, id);
          }

          if (!item) return;

          // Update cells
          row.querySelector("td:nth-child(6)").textContent =
            formatTplus(item.started) || "—";
          row.querySelector("td:nth-child(7)").textContent =
            formatDuration(item.started, item.ended) || "—";
          row.querySelector("td:nth-child(8)").textContent =
            formatTminus(item.next_start) || "—";
        });
      }, 1000);

      // Refresh buttons
      document
        .getElementById("account-refresh")
        .addEventListener("click", () => {
          if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ command: "read_user" }));
            ws.send(JSON.stringify({ command: "read_org" }));
          }
        });
      document.getElementById("refresh-tree").addEventListener("click", () => {
        if (ws && ws.readyState === WebSocket.OPEN) {
          document.getElementById("monitor-loading").style.display = "block";
          ws.send(JSON.stringify({ command: "find_cluster", name: "/root" }));
        }
      });
      document
        .getElementById("calendars-refresh")
        .addEventListener("click", () => {
          if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ command: "find_cal" }));
          }
        });
      document
        .getElementById("servers-refresh")
        .addEventListener("click", () => {
          if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ command: "find_monitor" }));
          }
        });

      // Copy token
      document.getElementById("copy-token").addEventListener("click", () => {
        const tokenInput = document.getElementById("account-token");
        if (!tokenInput.value) {
          showToast("No token to copy", "warning");
          return;
        }
        tokenInput.select();
        tokenInput.setSelectionRange(0, 99999);
        try {
          document.execCommand("copy");
          showToast("Token copied!", "success");
        } catch (err) {
          showToast("Failed to copy", "danger");
        }
      });

      // Save profile
      document.getElementById("save-profile").addEventListener("click", () => {
        const name = document.getElementById("edit-name").value.trim();
        const mode = document.getElementById("edit-mode").value.trim();
        if (!name && !mode) {
          showToast("No changes", "info");
          return;
        }
        if (ws && ws.readyState === WebSocket.OPEN) {
          ws.send(
            JSON.stringify({
              command: "update_user",
              name: name || undefined,
              mode: mode || undefined,
            }),
          );
          showToast("Profile update requested", "info");
        } else {
          showToast("Not connected", "danger");
        }
      });

      // Save org
      document.getElementById("save-org").addEventListener("click", () => {
        const payload = { command: "update_org" };
        const name = document.getElementById("edit-org-name").value.trim();
        const desc = document.getElementById("edit-org-desc").value.trim();
        if (name) payload.name = name;
        if (desc) payload.description = desc;
        if (Object.keys(payload).length === 1) {
          showToast("No changes", "info");
          return;
        }
        if (ws && ws.readyState === WebSocket.OPEN) {
          ws.send(JSON.stringify(payload));
          showToast("Organization update requested", "info");
        } else {
          showToast("Not connected", "danger");
        }
      });

      // Invite modal
      document.getElementById("invite-team").addEventListener("click", () => {
        document.getElementById("invite-modal").classList.add("is-active");
        document.getElementById("invite-email").value = "";
      });
      document.getElementById("cancel-invite").addEventListener("click", () => {
        document.getElementById("invite-modal").classList.remove("is-active");
      });
      document.getElementById("close-invite").addEventListener("click", () => {
        document.getElementById("invite-modal").classList.remove("is-active");
      });
      document.getElementById("send-invite").addEventListener("click", () => {
        const email = document.getElementById("invite-email").value.trim();
        if (!email) {
          showToast("Enter email", "danger");
          return;
        }
        if (ws && ws.readyState === WebSocket.OPEN) {
          ws.send(
            JSON.stringify({
              command: "register_user",
              email: email,
              team_member: "1",
            }),
          );
          showToast("Invitation sent", "success");
          document.getElementById("invite-modal").classList.remove("is-active");
        } else {
          showToast("Not connected", "danger");
        }
      });
    </script>
  </body>
</html>
