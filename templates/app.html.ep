              <td>✓</td>
              <td class="has-text-success"><strong>✓ Advanced cron</strong></td>
            </tr>
            <tr>
              <td>Self-healing</td>
              <td>Alerts only</td>
              <td>Alerts + retry</td>
              <td class="has-text-success"><strong>✓ Run recovery clusters</strong></td>
            </tr>
            <tr>
              <td>Easy migration</td>
