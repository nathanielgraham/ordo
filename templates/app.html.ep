        <!-- How It Works -->
        <section class="section">
          <div class="container">
            <h2 class="title has-text-centered is-3 mb-6">How It Works</h2>
            <div class="columns is-centered">
              <div class="column is-one-third">
                <div class="has-text-centered">
                  <span class="icon is-large has-text-primary mb-4"
                    ><i class="fas fa-folder-plus fa-3x"></i
                  ></span>
                  <h3 class="title is-5">1. Organize</h3>
                  <p>Create clusters and jobs — just like folders and files.</p>
                </div>
              </div>
              <div class="column is-one-third">
                <div class="has-text-centered">
                  <span class="icon is-large has-text-primary mb-4"
                    ><i class="fas fa-clock fa-3x"></i
                  ></span>
                  <h3 class="title is-5">2. Schedule</h3>
                  <p>
                    Use calendars with extended cron syntax — daily, weekly, or
                    "last Friday of the month".
                  </p>
                </div>
              </div>
              <div class="column is-one-third">
                <div class="has-text-centered">
                  <span class="icon is-large has-text-primary mb-4"
