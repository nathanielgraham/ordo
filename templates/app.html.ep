              <td>Hard</td>
              <td class="has-text-success"><strong>✓ Import JIL/crontab</strong></td>
            </tr>
            <tr>
              <td>Performance monitoring</td>
              <td>Limited</td>
              <td>Extra cost</td>
              <td class="has-text-success"><strong>✓ Historical charts</strong></td>
            </tr>
            <tr>
              <td>Dependency visualization</td>
