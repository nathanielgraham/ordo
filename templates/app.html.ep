<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ordo — Job Scheduler</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <style>

.ordo-tree-table {
  width: 100%;
  border-collapse: collapse;
}

.ordo-tree-table th, .ordo-tree-table td {
  padding: 8px 12px;
  border-bottom: 1px solid #ddd;
  text-align: left;
}

.ordo-tree-table tr {
  --depth: 0;  /* fallback */
}

.ordo-tree-table td:first-child {
  padding-left: calc(var(--depth) * 20px + 32px) !important;
}

.ordo-toggle {
  cursor: pointer;
  display: inline-block;
  width: 20px;
  margin-right: 8px;
  text-align: center;
  font-size: 1.1em;
}

.ordo-cluster-row.collapsed .ordo-toggle::after {
  content: '▶';
}

.ordo-cluster-row:not(.collapsed) .ordo-toggle::after {
  content: '▼';
}

/* Hide entire subtrees when collapsed */
tr[data-hidden="true"] {
  display: none !important;
}

.ordo-state {
  font-weight: 600; /* Slightly bold for visibility */
  text-transform: capitalize; /* Optional: makes "complete" look nicer */
}

/* Text colors only (no background) */
.ordo-complete { color: #28a745 !important; } /* green */
.ordo-immutable { color: #17a2b8 !important; } /* cyan */
.ordo-running   { color: #6f42c1 !important; } /* purple/magenta */
.ordo-failed    { color: #dc3545 !important; } /* red */
.ordo-ready     { color: #ffc107 !important; } /* yellow */
.ordo-default   { color: #6c757d !important; } /* gray */

/* Dark mode adjustments (if you use Bulma dark theme) */
@media (prefers-color-scheme: dark) {
  .ordo-complete { color: #4cd964 !important; } /* lighter green */
  .ordo-immutable { color: #4dd0e1 !important; }
  .ordo-running   { color: #9f7aea !important; }
  .ordo-failed    { color: #ff6b6b !important; }
  .ordo-ready     { color: #ffdd57 !important; }
  .ordo-default   { color: #adb5bd !important; }
}

    </style>
  </head>
  <body>
    <!-- Navbar -->
    <nav
      class="navbar is-fixed-top is-primary"
      role="navigation"
      aria-label="main navigation"
    >
      <div class="navbar-brand">
        <span class="navbar-item has-text-weight-bold is-size-4">
          <i class="fas fa-briefcase mr-2"></i> Ordo
        </span>
      </div>
      <div class="navbar-menu">
        <!-- Public Tabs -->
        <div class="navbar-start" id="public-tabs">
          <div class="tabs is-boxed is-centered">
            <ul>
              <li class="is-active" data-target="about">
                <span class="navbar-item">About</span>
              </li>
              <li data-target="docs"><span class="navbar-item">Docs</span></li>
              <li data-target="pricing">
                <span class="navbar-item">Pricing</span>
              </li>
            </ul>
          </div>
        </div>
        <!-- Private Tabs -->
        <div class="navbar-start" id="private-tabs" style="display: none">
          <div class="tabs is-boxed is-centered">
            <ul>
              <li class="is-active" data-target="account">
                <span class="navbar-item">Account</span>
              </li>
              <li data-target="monitor">
                <span class="navbar-item">Jobs & Clusters</span>
              </li>
              <li data-target="docs"><span class="navbar-item">Docs</span></li>
              <li data-target="calendars">
                <span class="navbar-item">Calendars</span>
              </li>
              <li data-target="servers">
                <span class="navbar-item">Servers</span>
              </li>
            </ul>
          </div>
        </div>
        <!-- End -->
        <div class="navbar-end">
          <div id="public-end">
            <a class="navbar-item" href="/login"
              ><i class="fas fa-sign-in-alt mr-2"></i> Sign In / Free Trial</a
            >
          </div>
          <div id="private-end" style="display: none">
            <a class="navbar-item" href="/logout"
              ><i class="fas fa-sign-out-alt mr-2"></i> Logout</a
            >
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="container mt-6">
      <!-- About -->
      <section id="about" class="tab-content">
        <h1 class="title is-1 has-text-centered">Welcome to Ordo</h1>
        <p class="subtitle is-3 has-text-centered mb-6">
          The hierarchical job scheduler for teams and individuals.
        </p>
        <div class="columns is-multiline is-centered">
          <div class="column is-one-third">
            <div class="card">
              <div class="card-content">
                <h3 class="title is-4">
                  <i class="fas fa-sitemap mr-2"></i> Organize Workflows
                </h3>
                <p>Build complex dependencies with clusters and jobs.</p>
              </div>
            </div>
          </div>
          <div class="column is-one-third">
            <div class="card">
              <div class="card-content">
                <h3 class="title is-4">
                  <i class="fas fa-calendar-check mr-2"></i> Schedule Reliably
                </h3>
                <p>Calendars and crons for precise timing.</p>
              </div>
            </div>
          </div>
          <div class="column is-one-third">
            <div class="card">
              <div class="card-content">
                <h3 class="title is-4">
                  <i class="fas fa-eye mr-2"></i> Monitor in Real-Time
                </h3>
                <p>Live status across servers and jobs.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="has-text-centered mt-6">
          <a href="/login" class="button is-primary is-large"
            >Get Started Free</a
          >
        </div>
      </section>

      <!-- Docs & Pricing (placeholders) -->
      <section id="docs" class="tab-content" style="display: none">
        <h1 class="title is-2 has-text-centered">Docs & Tutorials</h1>
        <p class="subtitle">Documentation and guides coming soon.</p>
      </section>
      <section id="pricing" class="tab-content" style="display: none">
        <h1 class="title is-2 has-text-centered">Pricing</h1>
        <p class="subtitle">
          Pricing details coming soon. Free tier available!
        </p>
      </section>

      <!-- Account Tab -->
      <section id="account" class="tab-content" style="display: none">
        <div class="container">
          <div class="has-text-centered mb-6">
            <h1 class="title is-2">Account & Organization</h1>
          </div>
          <div class="level mb-5">
            <div class="level-right">
              <button class="button is-info is-light" id="account-refresh">
                <i class="fas fa-sync mr-2"></i> Refresh
              </button>
            </div>
          </div>

          <div id="account-loading" class="has-text-centered">
            <i class="fas fa-spinner fa-spin"></i> Loading...
          </div>

          <div id="account-content" style="display: none">
            <div class="columns is-multiline">
              <!-- User Profile -->
              <div class="column is-6">
                <div class="card">
                  <header class="card-header">
                    <p class="card-header-title">
                      <i class="fas fa-user mr-2"></i> Your Profile
                    </p>
                  </header>
                  <div class="card-content">
                    <div class="columns is-multiline">
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Email</p>
                        <p id="account-email"></p>
                      </div>
                      <div class="column is-half">
                        <p class="has-text-weight-bold">User ID</p>
                        <p id="account-id"></p>
                      </div>
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Level</p>
                        <p id="account-level"></p>
                      </div>
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Name</p>
                        <input
                          class="input"
                          type="text"
                          id="edit-name"
                          placeholder="Your name"
                        />
                      </div>
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Mode (permissions)</p>
                        <input
                          class="input"
                          type="text"
                          id="edit-mode"
                          placeholder="770"
                        />
                      </div>
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Creation Time</p>
                        <p id="account-creation"></p>
                      </div>
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Last Update</p>
                        <p id="account-update"></p>
                      </div>
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Remote Address</p>
                        <p id="account-remote"></p>
                      </div>
                      <div class="column is-full">
                        <p class="has-text-weight-bold">
                          Token (for API calls)
                        </p>
                        <div class="field has-addons">
                          <div class="control is-expanded">
                            <input
                              class="input"
                              type="text"
                              id="account-token"
                              readonly
                            />
                          </div>
                          <div class="control">
                            <button class="button is-info" id="copy-token">
                              <i class="fas fa-copy"></i> Copy
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="has-text-right mt-4">
                      <button class="button is-primary" id="save-profile">
                        <i class="fas fa-save mr-2"></i> Save Profile
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Organization -->
              <div class="column is-6">
                <div class="card">
                  <header class="card-header">
                    <p class="card-header-title">
                      <i class="fas fa-building mr-2"></i> Organization
                    </p>
                  </header>
                  <div class="card-content">
                    <div class="columns is-multiline">
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Org ID</p>
                        <p id="org-id"></p>
                      </div>
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Name</p>
                        <input
                          class="input"
                          type="text"
                          id="edit-org-name"
                          placeholder="Organization name"
                        />
                      </div>
                      <div class="column is-full">
                        <p class="has-text-weight-bold">Description</p>
                        <textarea
                          class="textarea"
                          id="edit-org-desc"
                          placeholder="Organization description"
                        ></textarea>
                      </div>
                      <div class="column is-half">
                        <p class="has-text-weight-bold">Creation Time</p>
                        <p id="org-creation"></p>
                      </div>
                    </div>
                    <div class="has-text-right mt-4">
                      <button class="button is-primary" id="save-org">
                        <i class="fas fa-save mr-2"></i> Save Organization
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Team Members -->
            <div class="card mt-6">
              <header class="card-header">
                <p class="card-header-title">
                  <i class="fas fa-users mr-2"></i> Team Members
                </p>
              </header>
              <div class="card-content">
                <table class="table is-fullwidth is-striped" id="team-table">
                  <thead>
                    <tr>
                      <th>Email</th>
                      <th>ID</th>
                      <th>Level</th>
                      <th>Creation Time</th>
                    </tr>
                  </thead>
                  <tbody id="team-body"></tbody>
                </table>
                <p id="no-team" class="has-text-grey" style="display: none">
                  No team members yet.
                </p>
                <div class="mt-4">
                  <button class="button is-success" id="invite-team">
                    <i class="fas fa-user-plus mr-2"></i> Invite Team Member
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Jobs & Clusters Tab -->
      <section id="monitor" class="tab-content" style="display: none">
        <div class="container">
          <div class="has-text-centered mb-6">
            <h1 class="title is-2">Jobs & Clusters</h1>
          </div>

          <div class="level mb-5">
            <div class="level-right">
              <button class="button is-info is-light" id="refresh-tree">
                <i class="fas fa-sync"></i> Refresh
              </button>
            </div>
          </div>

          <div id="monitor-loading" class="has-text-centered">
            <i class="fas fa-spinner fa-spin"></i> Loading...
          </div>

          <div id="monitor-content" style="display: none">
            <div class="table-container">
              <table
                class="table is-fullwidth is-hoverable is-striped ordo-tree-table"
                id="tree-table"
              >
                <thead>
                  <tr>
                    <th>Path</th>
                    <th>ID</th>
                    <th>State</th>
                    <th>Server</th>
                    <th>PID</th>
                    <th>Last Start</th>
                    <th>Duration</th>
                    <th>Next Start</th>
                    <th>Calendar</th>
                    <th>Needs</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="tree-body"></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Calendars Tab -->
      <section id="calendars" class="tab-content" style="display: none">
        <div class="container">
          <div class="has-text-centered mb-6">
            <h1 class="title is-2">Calendars</h1>
          </div>

          <div class="level mb-5">
            <div class="level-right">
              <button class="button is-info is-light" id="calendars-refresh">
                <i class="fas fa-sync"></i> Refresh
              </button>
            </div>
          </div>

          <div id="calendars-loading" class="has-text-centered">
            <i class="fas fa-spinner fa-spin"></i> Loading...
          </div>

          <div id="calendars-content" style="display: none">
            <div class="table-container">
              <table
                class="table is-fullwidth is-hoverable is-striped"
                id="calendars-table"
              >
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Cron</th>
                    <th>State</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="calendars-body"></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Servers Tab -->
      <section id="servers" class="tab-content" style="display: none">
        <div class="container">
          <div class="has-text-centered mb-6">
            <h1 class="title is-2">Servers</h1>
          </div>

          <div class="level mb-5">
            <div class="level-right">
              <button class="button is-info is-light" id="servers-refresh">
                <i class="fas fa-sync"></i> Refresh
              </button>
            </div>
          </div>

          <div id="servers-loading" class="has-text-centered">
            <i class="fas fa-spinner fa-spin"></i> Loading...
          </div>

          <div id="servers-content" style="display: none">
            <div class="table-container">
              <table
                class="table is-fullwidth is-hoverable is-striped"
                id="servers-table"
              >
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Load</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="servers-body"></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Modal for Log View -->
    <div id="log-modal" class="modal">
      <div class="modal-background"></div>
      <div class="modal-card">
        <header class="modal-card-head">
          <p class="modal-card-title">Job Log</p>
          <button class="delete" aria-label="close"></button>
        </header>
        <section class="modal-card-body">
          <pre id="log-content"></pre>
        </section>
        <footer class="modal-card-foot">
          <button class="button is-info" id="refresh-log">Refresh Log</button>
          <button class="button is-primary" id="close-log">Close</button>
        </footer>
      </div>
    </div>

    <!-- Modal for Invite Team Member -->
    <div id="invite-modal" class="modal">
      <div class="modal-background"></div>
      <div class="modal-card">
        <header class="modal-card-head">
          <p class="modal-card-title">Invite Team Member</p>
          <button class="delete" aria-label="close" id="close-invite"></button>
        </header>
        <section class="modal-card-body">
          <div class="field">
            <label class="label">Email Address</label>
            <div class="control">
              <input
                class="input"
                type="email"
                id="invite-email"
                placeholder="Enter email to invite"
              />
            </div>
          </div>
        </section>
        <footer class="modal-card-foot">
          <button class="button is-primary" id="send-invite">
            Send Invite
          </button>
          <button class="button" id="cancel-invite">Cancel</button>
        </footer>
      </div>
    </div>

    <!-- Tab Switching -->
    <script>
      document.querySelectorAll(".tabs li").forEach((tab) => {
        tab.addEventListener("click", () => {
          document
            .querySelectorAll(".tabs li")
            .forEach((t) => t.classList.remove("is-active"));
          tab.classList.add("is-active");
          document.querySelectorAll(".tab-content").forEach((content) => {
            content.style.display =
              content.id === tab.dataset.target ? "block" : "none";
          });
        });
      });
    </script>

    <script>
      let ws = null;
      let monitorData = { tree: [], visibleItems: [], filter: "", expandedClusters: new Set() };
      let accountData = null;
      let orgData = null;
      let calendarsData = [];
      let serversData = [];

      document.addEventListener("DOMContentLoaded", () => {
        checkLoginAndConnect();

document.getElementById('tree-body').addEventListener('click', e => {
  const toggle = e.target.closest('.ordo-toggle');
  if (!toggle) return;

  const row = toggle.closest('tr');
  const isCollapsed = row.classList.toggle('collapsed');
  const parentId = row.dataset.id;

  // Toggle the entire subtree visibility
  toggleSubtree(parentId, isCollapsed);

  // If we're EXPANDING (isCollapsed === false), force-expand all descendant clusters
  // (reset their .collapsed class so arrows match the visible state)
  if (!isCollapsed) {
    function forceExpandDescendants(startParentId) {
      const directChildren = document.querySelectorAll(`tr[data-parent="${startParentId}"]`);
      directChildren.forEach(childRow => {
        if (childRow.classList.contains('ordo-cluster-row')) {
          childRow.classList.remove('collapsed');
          forceExpandDescendants(childRow.dataset.id);
        }
      });
    }
    forceExpandDescendants(parentId);
  }
});

      });

      function checkLoginAndConnect() {
        const token = document.cookie.match(/ordo_token=([^;]+)/)?.[1];
        if (token) {
          document.getElementById("public-tabs").style.display = "none";
          document.getElementById("private-tabs").style.display = "flex";
          document.getElementById("public-end").style.display = "none";
          document.getElementById("private-end").style.display = "flex";
          document.querySelector('[data-target="account"]').click();
          connectWS(token);
        } else {
          document.getElementById("public-tabs").style.display = "flex";
          document.getElementById("private-tabs").style.display = "none";
          document.getElementById("public-end").style.display = "flex";
          document.getElementById("private-end").style.display = "none";
          document.querySelector('[data-target="about"]').click();
        }
      }

      function connectWS(token) {
        const proto = location.protocol === "https:" ? "wss:" : "ws:";
        ws = new WebSocket(`${proto}//${location.host}/websocket`);

        ws.addEventListener("open", () => {
          console.log("WS connected");
          ws.send(JSON.stringify({ command: "login_user", token }));
        });

        ws.onmessage = (e) => {
          console.log("WS message:", e.data);
          try {
            const data = JSON.parse(e.data);

            if (data.command_reply === "login_user" && data.success) {
              console.log("Login success - requesting initial loads");
              ws.send(JSON.stringify({ command: "read_user" }));
              ws.send(JSON.stringify({ command: "read_org" }));
              ws.send(JSON.stringify({ command: "find_cluster" }));
              ws.send(JSON.stringify({ command: "find_cal" }));
              ws.send(JSON.stringify({ command: "find_monitor" }));
            }

            if (data.command_reply === "read_user") {
              updateAccount(data);
            }

            if (data.command_reply === "read_org") {
              updateOrgAndTeam(data);
            }

            if (data.command_reply === "find_cluster") {
              updateJobsClusters(data);
            }

            if (data.command_reply === "find_cal") {
              updateCalendars(data);
            }

            if (data.command_reply === "find_monitor") {
              updateServers(data);
            }

            // Broadcast handling
            if (data.broadcast === "clusters_changed") {
              applyClusterBroadcast(data);
            }

            if (data.broadcast === "jobs_changed") {
              applyJobBroadcast(data);
            }

            if (data.broadcast === "cals_changed") {
              applyCalBroadcast(data);
            }

            if (data.broadcast === "servers_changed") {
              applyServerBroadcast(data);
            }

            if (data.broadcast === "org_changed") {
              console.log("Org updated broadcast:", data);
              updateOrgAndTeam(data);
            }

            // Command replies (toasts)
            if (data.command_reply === "update_user") {
              showToast(
                data.success
                  ? "Profile updated"
                  : "Update failed: " + (data.message || "Unknown error"),
                data.success ? "success" : "danger",
              );
            }

            if (data.command_reply === "update_org") {
              showToast(
                data.success
                  ? "Organization updated"
                  : "Update failed: " + (data.message || "Unknown error"),
                data.success ? "success" : "danger",
              );
            }

            if (data.command_reply === "register_user") {
              showToast(
                data.success
                  ? "Invitation sent"
                  : "Invite failed: " + (data.message || "Unknown error"),
                data.success ? "success" : "danger",
              );
              const inviteModal = document.getElementById("invite-modal");
              if (inviteModal.classList.contains("is-active")) {
                inviteModal.classList.remove("is-active");
              }
            }
          } catch (err) {
            console.error("Parse error:", err);
          }
        };

        ws.onclose = () => {
          console.log("WS closed");
          setTimeout(checkLoginAndConnect, 5000);
        };
      }

      // Shared utilities
      function showToast(message, type = "info") {
        const toast = document.createElement("div");
        toast.className = `notification is-${type}`;
        toast.innerHTML = `<button class="delete"></button><span>${message}</span>`;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
      }

      function showLoading(containerId) {
        const loading = document.getElementById(containerId);
        if (loading) loading.style.display = "block";
      }

      function hideLoading(containerId) {
        const loading = document.getElementById(containerId);
        if (loading) loading.style.display = "none";
      }

      function formatDate(epoch) {
        if (!epoch) return "—";
        return new Date(epoch * 1000).toLocaleString();
      }

      function formatTminus(epoch) {
        if (!epoch || isNaN(epoch)) return "—";
        const diff = epoch - Math.floor(Date.now() / 1000);
        const abs = Math.abs(diff);
        const sign = diff >= 0 ? "+" : "-";
        const h = Math.floor(abs / 3600)
          .toString()
          .padStart(2, "0");
        const m = Math.floor((abs % 3600) / 60)
          .toString()
          .padStart(2, "0");
        const s = (abs % 60).toString().padStart(2, "0");
        return `T${sign}${h}:${m}:${s}`;
      }

      function formatDuration(start, end) {
        if (!start) return "—";
        const endTime = end || Math.floor(Date.now() / 1000);
        const diff = endTime - start;
        if (diff <= 0) return "—";
        const h = Math.floor(diff / 3600)
          .toString()
          .padStart(2, "0");
        const m = Math.floor((diff % 3600) / 60)
          .toString()
          .padStart(2, "0");
        const s = (diff % 60).toString().padStart(2, "0");
        return `${h}:${m}:${s}`;
      }

function stateClass(state) {
  if (!state) return 'ordo-default';

  const lowerState = state.toLowerCase();

  // Green family
  if (['complete', 'pruned', 'ice'].includes(lowerState)) {
    return 'ordo-complete';
  }

  // Cyan/Blue family
  if (['immutable', 'ice'].includes(lowerState)) {
    return 'ordo-immutable';
  }

  // Magenta/Purple family (running)
  if (lowerState === 'running') {
    return 'ordo-running';
  }

  // Red family
  if (['failed', 'hold', 'zombie', 'killed'].includes(lowerState)) {
    return 'ordo-failed';
  }

  // Yellow family
  if (['ready', 'waiting', 'looping', 'retrying'].includes(lowerState)) {
    return 'ordo-ready';
  }

  // Default
  return 'ordo-default';
}

      // Render user profile
      function renderUserProfile() {
        if (!accountData || !accountData.success) return;
        document.getElementById("account-email").textContent =
          accountData.email || "—";
        document.getElementById("account-id").textContent =
          accountData.id || "—";
        document.getElementById("account-level").textContent =
          accountData.level || "—";
        document.getElementById("edit-name").value = accountData.name || "";
        document.getElementById("edit-mode").value = accountData.mode || "";
        document.getElementById("account-creation").textContent =
          formatDate(accountData.creation_time) || "—";
        document.getElementById("account-update").textContent =
          formatDate(accountData.update_time) || "—";
        document.getElementById("account-remote").textContent =
          accountData.remote_address || "—";
        document.getElementById("account-token").value =
          accountData.token || "—";
      }

      // Update account
      function updateAccount(data) {
        accountData = data;
        hideLoading("account-loading");
        document.getElementById("account-content").style.display = "block";
        renderUserProfile();
      }

      // Render org and team
      function renderOrgTeam() {
        if (!orgData) return;
