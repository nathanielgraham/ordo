      <!-- Jobs & Clusters Tab -->
      <section id="monitor" class="tab-content" style="display: none">
        <div class="container">
          <div class="has-text-centered mb-6">
            <h1 class="title is-2">Jobs & Clusters</h1>
          </div>
          <div class="has-text-centered mb-5">
            <div class="field has-addons is-centered">
              <div class="control">
                <button class="button is-info is-light" id="refresh-tree">
                  <span class="icon"><i class="fas fa-sync"></i></span>
                  <span>Refresh</span>
                </button>
              </div>
              <div class="control">
                <div
                  class="button is-static is-info is-light"
                  id="current-time"
                >
                  Loading...
                </div>
              </div>
            </div>
          </div>
          <div id="monitor-loading" class="has-text-centered py-6">
            <span class="icon is-large"
              ><i class="fas fa-spinner fa-spin fa-3x"></i
            ></span>
            <p class="mt-2">Loading jobs & clusters...</p>
          </div>
          <div id="monitor-content" style="display: none">
            <div class="table-container">
              <table
                class="table is-fullwidth is-hoverable is-striped ordo-tree-table"
                id="tree-table"
                role="treegrid"
                aria-label="Jobs and Clusters Hierarchy"
              >
                <thead>
                  <tr>
                    <th>Path</th>
                    <th>ID</th>
                    <th>State</th>
                    <th>Server</th>
                    <th>PID</th>
                    <th>Last Start</th>
                    <th>Duration</th>
                    <th>Next Start</th>
                    <th>Calendar</th>
                    <th>Needs</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="tree-body"></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <!-- Calendars Tab -->
      <section id="calendars" class="tab-content" style="display: none">
        <div class="container">
          <div class="has-text-centered mb-6">
            <h1 class="title is-2">Calendars</h1>
