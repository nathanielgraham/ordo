<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-100 dark:bg-gray-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ordo — Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="h-full flex items-center justify-center">
  <div class="max-w-md w-full bg-white dark:bg-gray-800 rounded-xl shadow-2xl p-8">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white">Ordo</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">Job Scheduler & Monitor</p>
    </div>

    <% if (flash 'message') { %>
      <div class="mb-6 p-4 bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-200 rounded-lg">
        <%= flash 'message' %>
      </div>
    <% } %>

    <% if (stash 'error') { %>
      <div class="mb-6 p-4 bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-200 rounded-lg">
        <%= stash 'error' %>
      </div>
    <% } %>

    <form method="post" action="/login" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          Email address
        </label>
        <input type="email" name="email" required autocomplete="email"
               class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700">
      </div>

      <button type="submit"
              class="w-full py-4 px-6 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-lg rounded-lg shadow-md transition">
        Send Login Link
      </button>
    </form>

    <p class="mt-4 text-center text-sm text-gray-600 dark:text-gray-400">
      We'll email you a magic link — no password required.
    </p>

    <hr class="my-8 border-gray-200 dark:border-gray-700">

    <form method="post" action="/login-token" class="space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
          Or paste your API token
        </label>
        <input type="password" name="token" required autocomplete="off"
               placeholder="Paste token from admin or CLI"
               class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-indigo-500 dark:bg-gray-700">
      </div>

      <button type="submit"
              class="w-full py-4 px-6 bg-gray-700 hover:bg-gray-800 text-white font-bold text-lg rounded-lg shadow-md transition">
        Log in with token
      </button>
    </form>

    <p class="mt-4 text-center text-sm text-gray-500 dark:text-gray-400">
      Self-hosted: your admin can create an account and give you a token or a one-time link.
    </p>
  </div>
</body>
</html>
