<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ordo — Job Scheduler</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body x-data="appData()" x-init="initApp()">
  <!-- Navbar -->
  <nav class="navbar is-fixed-top is-primary" role="navigation" aria-label="main navigation">
    <div class="navbar-brand">
      <span class="navbar-item has-text-weight-bold is-size-4">
        <i class="fas fa-briefcase mr-2"></i> Ordo
      </span>
    </div>
    <div class="navbar-menu">
      <!-- Public Tabs (logged out) -->
      <div class="navbar-start" id="public-tabs">
        <span class="navbar-item" @click="showTab('about')">
          <i class="fas fa-info-circle mr-2"></i> About
        </span>
        <span class="navbar-item" @click="showTab('docs')">
          <i class="fas fa-book mr-2"></i> Docs
        </span>
        <span class="navbar-item" @click="showTab('pricing')">
          <i class="fas fa-dollar-sign mr-2"></i> Pricing
        </span>
      </div>

      <!-- Private Tabs (logged in) -->
      <div class="navbar-start" id="private-tabs" style="display: none;">
        <span class="navbar-item" @click="showTab('account')">
          <i class="fas fa-user mr-2"></i> Account
        </span>
        <span class="navbar-item" @click="showTab('monitor')">
          <i class="fas fa-tasks mr-2"></i> Jobs & Clusters
        </span>
        <span class="navbar-item" @click="showTab('calendars')">
          <i class="fas fa-calendar-alt mr-2"></i> Calendars
        </span>
        <span class="navbar-item" @click="showTab('servers')">
          <i class="fas fa-server mr-2"></i> Servers
        </span>
      </div>

      <!-- End Section -->
      <div class="navbar-end">
        <div id="public-end">
          <a class="navbar-item" href="/login">
            <i class="fas fa-sign-in-alt mr-2"></i> Sign In / Free Trial
          </a>
        </div>
        <div id="private-end" style="display: none;">
          <a class="navbar-item" href="/logout">
            <i class="fas fa-sign-out-alt mr-2"></i> Logout
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="container mt-6">
    <!-- About Tab -->
    <section id="about-tab">
      <h1 class="title is-1 has-text-centered">Welcome to Ordo</h1>
      <p class="subtitle is-3 has-text-centered mb-6">The hierarchical job scheduler for teams and individuals.</p>
      <div class="columns is-multiline is-centered">
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content">
              <h3 class="title is-4"><i class="fas fa-sitemap mr-2"></i> Organize Workflows</h3>
              <p>Build complex dependencies with clusters and jobs.</p>
            </div>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content">
              <h3 class="title is-4"><i class="fas fa-calendar-check mr-2"></i> Schedule Reliably</h3>
              <p>Calendars and crons for precise timing.</p>
            </div>
          </div>
        </div>
        <div class="column is-one-third">
          <div class="card">
            <div class="card-content">
              <h3 class="title is-4"><i class="fas fa-eye mr-2"></i> Monitor in Real-Time</h3>
              <p>Live status across servers and jobs.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="has-text-centered mt-6">
        <a href="/login" class="button is-primary is-large">Get Started Free</a>
      </div>
    </section>

    <!-- Docs Tab -->
    <section id="docs-tab" style="display: none;">
      <h1 class="title is-2">Docs & Tutorials</h1>
      <p class="subtitle">Documentation and guides coming soon.</p>
    </section>

    <!-- Pricing Tab -->
    <section id="pricing-tab" style="display: none;">
      <h1 class="title is-2">Pricing</h1>
      <p class="subtitle">Pricing details coming soon. Free tier available!</p>
    </section>

    <!-- Account Tab -->
    <section id="account-tab" class="section" x-data="accountApp()" style="display: none;">
      <div class="container">
        <div class="level mb-5">
          <div class="level-left">
            <h1 class="title is-2">Account & Organization</h1>
          </div>
          <div class="level-right">
            <button class="button is-info is-light" @click="loadAccount" :disabled="loading">
              <i class="fas fa-sync mr-2" :class="{ 'fa-spin': loading }"></i>
              Refresh
            </button>
          </div>
        </div>

        <!-- Toast Notification -->
        <div class="notification" x-show="toastMessage" :class="toastType">
          <button class="delete" @click="toastMessage = ''"></button>
          <span x-text="toastMessage"></span>
        </div>

        <div class="columns is-multiline">
          <!-- Your Profile -->
          <div class="column is-6">
            <div class="card">
              <header class="card-header">
                <p class="card-header-title"><i class="fas fa-user mr-2"></i> Your Profile</p>
              </header>
              <div class="card-content">
                <template x-if="loading">
                  <p class="has-text-centered">Loading...</p>
                </template>
                <div class="columns is-multiline" x-show="!loading && user.id">
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Email</p>
                    <p x-text="user.email || '—'"></p>
                  </div>
                  <div class="column is-half">
                    <p class="has-text-weight-bold">User ID</p>
                    <p x-text="user.id || '—'"></p>
                  </div>
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Level</p>
                    <p x-text="user.level || '—'"></p>
                  </div>
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Name</p>
                    <input class="input" type="text" x-model="editUser.name" placeholder="Your name">
                  </div>
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Mode (permissions)</p>
                    <input class="input" type="text" x-model="editUser.mode" placeholder="770">
                  </div>
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Creation Time</p>
                    <p x-text="formatDate(user.creation_time) || '—'"></p>
                  </div>
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Last Update</p>
                    <p x-text="formatDate(user.update_time) || '—'"></p>
                  </div>
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Remote Address</p>
                    <p x-text="user.remote_address || '—'"></p>
                  </div>
                  <div class="column is-full">
                    <p class="has-text-weight-bold">Token (for API calls)</p>
                    <div class="field has-addons">
                      <div class="control is-expanded">
                        <input class="input" type="text" x-model="user.token" readonly>
                      </div>
                      <div class="control">
                        <button class="button is-info" @click="copyToken">
                          <i class="fas fa-copy"></i> Copy
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="has-text-right mt-4">
                  <button class="button is-primary" @click="saveUser" :disabled="!hasUserChanges || loading">
                    <i class="fas fa-save mr-2"></i> Save Profile
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Organization -->
          <div class="column is-6">
            <div class="card">
              <header class="card-header">
                <p class="card-header-title"><i class="fas fa-building mr-2"></i> Organization</p>
              </header>
              <div class="card-content">
                <div class="columns is-multiline" x-show="!loading && org.id">
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Org ID</p>
                    <p x-text="org.id || '—'"></p>
                  </div>
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Name</p>
                    <input class="input" type="text" x-model="editOrg.name" placeholder="Organization name">
                  </div>
                  <div class="column is-full">
                    <p class="has-text-weight-bold">Description</p>
                    <textarea class="textarea" x-model="editOrg.description" placeholder="Organization description"></textarea>
                  </div>
                  <div class="column is-half">
                    <p class="has-text-weight-bold">Creation Time</p>
                    <p x-text="formatDate(org.creation_time) || '—'"></p>
                  </div>
                </div>
                <div class="has-text-right mt-4">
                  <button class="button is-primary" @click="saveOrg" :disabled="!hasOrgChanges || loading">
                    <i class="fas fa-save mr-2"></i> Save Organization
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Team Members -->
        <div class="card mt-6">
          <header class="card-header">
            <p class="card-header-title"><i class="fas fa-users mr-2"></i> Team Members</p>
          </header>
          <div class="card-content">
            <table class="table is-fullwidth is-striped" x-show="user.group?.length">
              <thead>
                <tr>
                  <th>Email</th>
                  <th>ID</th>
                  <th>Level</th>
                  <th>Creation Time</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="member in user.group" :key="member.id">
                  <tr>
                    <td x-text="member.email || '—'"></td>
                    <td x-text="member.id || '—'"></td>
                    <td x-text="member.level || '—'"></td>
                    <td x-text="formatDate(member.creation_time) || '—'"></td>
                  </tr>
                </template>
              </tbody>
            </table>
            <p class="has-text-grey" x-show="!user.group?.length">No team members yet.</p>
            <div class="mt-4">
              <button class="button is-success" @click="openInviteModal">
                <i class="fas fa-user-plus mr-2"></i> Invite Team Member
              </button>
            </div>
          </div>
        </div>

        <!-- Invite Modal -->
        <div class="modal" :class="{ 'is-active': inviteModalOpen }">
          <div class="modal-background" @click="inviteModalOpen = false"></div>
          <div class="modal-content">
            <div class="box">
              <h3 class="title is-4"><i class="fas fa-envelope mr-2"></i> Invite to Organization</h3>
              <input class="input mb-4" type="email" x-model="inviteEmail" placeholder="Email address">
              <p class="help is-info">They'll receive a confirmation email. They'll appear in the team list after confirming.</p>
              <div class="field is-grouped is-grouped-right mt-5">
                <div class="control">
                  <button class="button" @click="inviteModalOpen = false">Cancel</button>
                </div>
                <div class="control">
                  <button class="button is-primary" @click="sendInvite" :disabled="!inviteEmail || loading">
                    Send Invite
                  </button>
                </div>
              </div>
            </div>
          </div>
          <button class="modal-close is-large" @click="inviteModalOpen = false"></button>
        </div>
      </div>
    </section>

    <!-- Placeholder Tabs -->
    <section id="monitor-tab" style="display: none;">
      <h1 class="title is-2">Jobs & Clusters</h1>
      <p class="subtitle">Tree view coming soon...</p>
    </section>
    <section id="calendars-tab" style="display: none;">
      <h1 class="title is-2">Calendars</h1>
      <p class="subtitle">Calendar management coming soon...</p>
    </section>
    <section id="servers-tab" style="display: none;">
      <h1 class="title is-2">Servers</h1>
      <p class="subtitle">Server monitoring coming soon...</p>
    </section>
  </main>

  <!-- JavaScript -->
  <script>
    // Global WebSocket + login check
    let ws = null;
    let accountInstance = null;

    function checkLoginAndConnect() {
      const token = document.cookie.match(/ordo_token=([^;]+)/)?.[1];
      if (token) {
        document.getElementById('public-tabs').style.display = 'none';
        document.getElementById('private-tabs').style.display = 'flex';
        document.getElementById('public-end').style.display = 'none';
        document.getElementById('private-end').style.display = 'flex';
        connectWS(token);
      } else {
        document.getElementById('public-tabs').style.display = 'flex';
        document.getElementById('private-tabs').style.display = 'none';
        document.getElementById('public-end').style.display = 'flex';
        document.getElementById('private-end').style.display = 'none';
      }
    }

    function connectWS(token) {
      const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      ws = new WebSocket(`${proto}//${location.host}/websocket`);

      ws.onopen = () => {
        console.log('WS connected');
        ws.send(JSON.stringify({ command: 'login_user', token }));
      };

      ws.onmessage = (e) => {
        console.log('WS message:', e.data);
        try {
          const data = JSON.parse(e.data);

          if (data.command_reply === 'login_user' && data.success) {
            console.log('Login success - requesting read_user');
            ws.send(JSON.stringify({ command: 'read_user' }));
          }

          if (accountInstance) {
            if (data.command_reply === 'read_user') {
              accountInstance.onReadUser(data);
            }
            if (data.command_reply === 'update_user') {
              if (data.success) {
                accountInstance.showToast('Profile updated successfully!', 'is-success');
                accountInstance.loadAccount();
              } else {
                accountInstance.showToast('Update failed: ' + (data.message || 'Unknown error'), 'is-danger');
              }
              accountInstance.loading = false;
            }
            if (data.command_reply === 'update_org') {
              if (data.success) {
                accountInstance.showToast('Organization updated successfully!', 'is-success');
                accountInstance.loadAccount();
              } else {
                accountInstance.showToast('Update failed: ' + (data.message || 'Unknown error'), 'is-danger');
              }
              accountInstance.loading = false;
            }
            if (data.command_reply === 'register_user') {
              if (data.success) {
                accountInstance.showToast('Invite sent! They’ll appear after confirming.', 'is-success');
                accountInstance.loadAccount();
              } else {
                accountInstance.showToast('Invite failed: ' + (data.message || 'Unknown error'), 'is-danger');
              }
              accountInstance.loading = false;
            }
          }
        } catch (err) {
          console.error('Parse error:', err);
        }
      };

      ws.onclose = () => {
        console.log('WS closed');
        setTimeout(() => checkLoginAndConnect(), 5000);
      };
    }

    // Run on load
    checkLoginAndConnect();

    // Global Alpine data for tab switching
    function appData() {
      return {
        showTab(tabId) {
          console.log('Switching to tab:', tabId);
          document.querySelectorAll('section[id$="-tab"]').forEach(tab => {
            tab.style.display = 'none';
          });
          const target = document.getElementById(tabId + '-tab');
          if (target) target.style.display = 'block';
        },

        initApp() {
          console.log('Alpine initialized - setting default tab');
          const token = document.cookie.match(/ordo_token=([^;]+)/)?.[1];
          if (token) {
            this.showTab('account');
          } else {
            this.showTab('about');
          }
        }
      }
    }

    // Alpine component for Account tab
    function accountApp() {
      return {
        user: {},
        org: {},
        editUser: { name: '', mode: '' },
        editOrg: { name: '', description: '' },
        inviteModalOpen: false,
        inviteEmail: '',
        toastMessage: '',
        toastType: 'is-info',
        loading: false,

        init() {
          console.log('Account component initialized');
          accountInstance = this;
          this.loadAccount();
        },

        loadAccount() {
          console.log('Loading account data...');
          this.loading = true;
          if (ws?.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ command: 'read_user' }));
          }
        },

        onReadUser(data) {
          console.log('Received read_user:', data);
          this.loading = false;
          if (data.success) {
            this.user = data;
            this.org = data.org || {};
            this.editUser = { name: data.name || '', mode: data.mode || '' };
            this.editOrg = { name: data.org?.name || '', description: data.org?.description || '' };
          } else {
            this.showToast('Failed to load account: ' + (data.message || 'Unknown error'), 'is-danger');
          }
        },

        hasUserChanges() {
          return this.editUser.name !== this.user.name || this.editUser.mode !== this.user.mode;
        },

        hasOrgChanges() {
          return this.editOrg.name !== this.org.name || this.editOrg.description !== this.org.description;
        },

        saveUser() {
          if (!this.hasUserChanges()) return;
          this.loading = true;
          ws.send(JSON.stringify({
            command: 'update_user',
            name: this.editUser.name,
            mode: this.editUser.mode
          }));
        },

        saveOrg() {
          if (!this.hasOrgChanges()) return;
          this.loading = true;
          ws.send(JSON.stringify({
            command: 'update_org',
            name: this.editOrg.name,
            description: this.editOrg.description
          }));
        },

        openInviteModal() {
          this.inviteModalOpen = true;
          this.inviteEmail = '';
        },

        sendInvite() {
          if (!this.inviteEmail) return this.showToast('Enter an email address', 'is-warning');
          this.loading = true;
          ws.send(JSON.stringify({
            command: 'register_user',
            email: this.inviteEmail,
            team_member: 1
          }));
          this.inviteModalOpen = false;
        },

        copyToken() {
          const token = this.user.token;
          if (!token) return this.showToast('No token to copy', 'is-warning');

          if (navigator.clipboard?.writeText) {
            navigator.clipboard.writeText(token).then(() => {
              this.showToast('Token copied!', 'is-success');
            }).catch(err => {
              console.error('Clipboard API error:', err);
              this.fallbackCopy(token);
            });
          } else {
            this.fallbackCopy(token);
          }
        },

        fallbackCopy(token) {
          const textArea = document.createElement('textarea');
          textArea.value = token;
          textArea.style.position = 'fixed';
          textArea.style.top = '0';
          textArea.style.left = '0';
          textArea.style.opacity = '0';
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();

          try {
            const successful = document.execCommand('copy');
            if (successful) {
              this.showToast('Token copied! (legacy)', 'is-success');
            } else {
              this.showToast('Failed to copy token', 'is-danger');
            }
          } catch (err) {
            console.error('Fallback copy error:', err);
            this.showToast('Failed to copy token', 'is-danger');
          }

          document.body.removeChild(textArea);
        },

        showToast(msg, type = 'is-info') {
          this.toastMessage = msg;
          this.toastType = type;
          setTimeout(() => this.toastMessage = '', 5000);
        },

        formatDate(epoch) {
          return epoch ? new Date(epoch * 1000).toLocaleString() : '—';
        }
      }
    }
  </script>
</body>
</html>
