<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50 dark:bg-gray-900" x-data="monitorApp()">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ordo • Jobs & Clusters</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
    .tree-row:hover { background-color: rgba(99, 102, 241, 0.05); }
  </style>
</head>
<body class="h-full flex flex-col">
  <div class="bg-indigo-700 text-white p-4 shadow-lg">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <h1 class="text-2xl font-bold">Ordo • Jobs & Clusters</h1>
      <div class="text-sm">
        <span x-text="currentPath" class="font-medium"></span>
        <span class="ml-6">Local time: <span x-text="now"></span></span>
      </div>
    </div>
  </div>

  <div class="flex-1 overflow-hidden" x-init="init()">
    <div class="max-w-7xl mx-auto p-6">
      <!-- Search & Status -->
      <div class="mb-6 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
        <input type="text" placeholder="Search jobs or clusters..." class="flex-1 px-4 py-2 border rounded-lg dark:bg-gray-800"
               @input.debounce.500ms="filter = $event.target.value">
        <div class="text-sm text-gray-600 dark:text-gray-400">
          <span x-show="connected" class="text-green-600">● Connected</span>
          <span x-show="!connected" class="text-red-600">● Reconnecting...</span>
          <span class="ml-4" x-text="visibleItems.length + ' items'"></span>
        </div>
        <button @click="refresh()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg">
          Refresh
        </button>
      </div>

      <!-- Tree Table -->
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-hidden">
        <table class="w-full">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">State</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Server</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Last Run</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Duration</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Next Run</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Calendar</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            <template x-for="item in visibleItems" :key="item.id + '-' + item.type">
              <tr class="tree-row cursor-pointer" @click="selected = item">
                <td class="py-3" :style="{ paddingLeft: (item.depth * 28 + 24) + 'px' }">
                  <div class="flex items-center">
                    <!-- Toggle for clusters with children -->
                    <template x-if="item.is_cluster && item.children?.length">
                      <button @click.stop="item.open = !item.open" class="mr-1">
                        <svg x-show="!item.open" class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                        <svg x-show="item.open" class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </button>
                    </template>
                    <template x-if="!item.is_cluster || !item.children?.length">
                      <span class="w-5 inline-block"></span>
                    </template>

                    <!-- Icon -->
                    <span class="mr-2 text-lg">
                      <span x-show="item.is_cluster">📁</span>
                      <span x-show="!item.is_cluster">📄</span>
                    </span>

                    <!-- Name -->
                    <span x-text="item.name"
                          :class="item.is_cluster ? 'font-medium text-blue-600 dark:text-blue-400' : 'text-gray-900 dark:text-gray-100'"></span>
                    <span x-show="item.is_cluster" class="text-blue-600 dark:text-blue-400 ml-1">/</span>
                  </div>
                </td>
                <td class="px-6 py-3">
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full"
                        :class="{
                          'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200': item.jobstate === 'complete',
                          'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200': item.jobstate === 'running',
                          'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200': item.jobstate === 'failed',
                          'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200': ['waiting', 'ready'].includes(item.jobstate),
                          'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300': true
                        }"
                        x-text="item.jobstate || '—'"></span>
                </td>
                <td class="px-6 py-3 text-sm text-gray-900 dark:text-gray-300" x-text="item.server_name || '—'"></td>
                <td class="px-6 py-3 text-sm text-gray-900 dark:text-gray-300" x-text="item.last_start || '—'"></td>
                <td class="px-6 py-3 text-sm text-gray-900 dark:text-gray-300" x-text="item.duration || '—'"></td>
                <td class="px-6 py-3 text-sm text-gray-900 dark:text-gray-300" x-text="item.next_start || '—'"></td>
                <td class="px-6 py-3 text-sm text-gray-900 dark:text-gray-300" x-text="item.cal_name || '—'"></td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>

      <!-- Details Modal -->
      <div x-show="selected" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50" @click="selected = null">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-2xl w-full mx-4 p-6" @click.stop>
          <h2 class="text-2xl font-bold mb-4" x-text="selected.name + (selected.is_cluster ? '/' : '')"></h2>
          <div class="grid grid-cols-2 gap-4 text-sm">
            <div><strong>ID:</strong> <span x-text="selected.id"></span></div>
            <div><strong>Type:</strong> <span x-text="selected.is_cluster ? 'Cluster' : 'Job'"></span></div>
            <div><strong>State:</strong> <span x-text="selected.jobstate"></span></div>
            <div><strong>Server:</strong> <span x-text="selected.server_name || '—'"></span></div>
            <div x-show="!selected.is_cluster"><strong>Script:</strong> <span x-text="selected.script || '—'"></span></div>
            <div><strong>Last Run:</strong> <span x-text="selected.last_start || 'never'"></span></div>
            <div><strong>Duration:</strong> <span x-text="selected.duration || '—'"></span></div>
            <div><strong>Next Run:</strong> <span x-text="selected.next_start || '—'"></span></div>
            <div><strong>Calendar:</strong> <span x-text="selected.cal_name || '—'"></span></div>
          </div>
          <div class="mt-6 flex justify-end">
            <button @click="selected = null" class="px-4 py-2 bg-gray-300 hover:bg-gray-400 dark:bg-gray-700 rounded">Close</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    function monitorApp() {
      return {
        tree: [],
        visibleItems: [],
        currentPath: '/',
        filter: '',
        connected: false,
        selected: null,
        now: new Date().toLocaleString(),
        ws: null,

        init() {
          setInterval(() => this.now = new Date().toLocaleString(), 1000);
          this.connectWebSocket();
          this.refresh();
        },

        connectWebSocket() {
          const token = this.getToken();
          if (!token) return location.href = '/login';

          const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
          this.ws = new WebSocket(`${proto}//${location.host}/websocket`);

          this.ws.onopen = () => {
            this.connected = true;
            this.ws.send(JSON.stringify({ command: "login_user", token }));
            this.refresh();
          };

          this.ws.onmessage = (e) => {
            const data = JSON.parse(e.data);
            if (data.command_reply === 'find_cluster' && data.success) {
              this.buildTree(data);
            }
          };

          this.ws.onclose = () => {
            this.connected = false;
            setTimeout(() => this.connectWebSocket(), 3000);
          };
        },

        refresh() {
          if (this.ws?.readyState === WebSocket.OPEN) {
            this.ws.send(JSON.stringify({ command: "find_cluster" }));
          }
        },

        buildTree(data) {
          this.currentPath = data.path || '/';

          const nodes = new Map();
          const root = { id: 'root', children: [], open: true };

          // Add all clusters
          data.clusters.forEach(cluster => {
            nodes.set(cluster.id, {
              ...cluster,
              type: 'cluster',
              is_cluster: true,
              children: [],
              open: true,
              depth: 0
            });
          });

          // Build hierarchy
          data.clusters.forEach(cluster => {
            const node = nodes.get(cluster.id);
            const parentId = cluster.parent_id || 'root';
            const parent = parentId === 'root' ? root : nodes.get(parentId);
            if (parent) parent.children.push(node);
          });

          // Add jobs to their cluster
          data.clusters.forEach(cluster => {
            if (cluster.jobs) {
              const clusterNode = nodes.get(cluster.id);
              cluster.jobs.forEach(job => {
                clusterNode.children.push({
                  ...job,
                  type: 'job',
                  is_cluster: false,
                  name: job.name,
                  jobstate: job.jobstate,
                  server_name: job.server_name,
                  script: job.script
                });
              });
            }
          });

          this.tree = root.children;
          this.applyFilter();
        },

        applyFilter() {
          const filterLower = this.filter.toLowerCase();
          const visible = [];

          const walk = (items, depth = 0) => {
            items.forEach(item => {
              const matches = !this.filter ||
                item.name.toLowerCase().includes(filterLower) ||
                (item.server_name && item.server_name.toLowerCase().includes(filterLower));

              if (matches || item.is_cluster) {
                visible.push({
                  ...item,
                  depth,
                  last_start: this.formatRelative(item.started),
                  duration: this.formatDuration(item.ended && item.started ? item.ended - item.started : 0),
                  next_start: this.formatRelative(item.next_start)
                });
              }

              if (item.is_cluster && item.open && item.children.length) {
                walk(item.children, depth + 1);
              }
            });
          };

          walk(this.tree);
          this.visibleItems = visible;
        },

        formatRelative(epoch) {
          if (!epoch) return '';
          const diff = epoch - Math.floor(Date.now() / 1000);
          const abs = Math.abs(diff);
          const h = String(Math.floor(abs / 3600)).padStart(2, '0');
          const m = String(Math.floor((abs % 3600) / 60)).padStart(2, '0');
          const s = String(abs % 60).padStart(2, '0');
          return `T${diff < 0 ? '+' : '-'} ${h}:${m}:${s}`;
        },

        formatDuration(seconds) {
          if (!seconds) return '';
          const h = String(Math.floor(seconds / 3600)).padStart(2, '0');
          const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
          const s = String(seconds % 60).padStart(2, '0');
          return `${h}:${m}:${s}`;
        },

        getToken() {
          const match = document.cookie.match(/ordo_token=([^;]+)/);
          if (match) return decodeURIComponent(match[1]);
          return new URLSearchParams(window.location.search).get('token');
        }
      }
    }
  </script>
</body>
</html>
